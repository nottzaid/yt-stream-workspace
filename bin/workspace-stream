#!/usr/bin/env bash
# workspace-stream: stream one Hyprland workspace to YouTube while every other
# workspace stays private. The compositor side of the boundary lives in
# hyprland/yt-stream-workspace.lua; see docs/ARCHITECTURE.md.
set -Eeuo pipefail

PROTOCOL=1
PREVIEW_TITLE="yt-stream-workspace preview"

CONFIG_FILE="${YTWS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/yt-stream-workspace/config}"
if [[ -r "$CONFIG_FILE" ]]; then
    # User-owned shell config containing YTWS_* assignments.
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

OUTPUT="${YTWS_OUTPUT:-YT-STREAM}"
WIDTH="${YTWS_WIDTH:-1920}"
HEIGHT="${YTWS_HEIGHT:-1080}"
FPS="${YTWS_FPS:-60}"
SCALE="${YTWS_SCALE:-1.5}"
VIDEO_BITRATE="${YTWS_VIDEO_BITRATE:-12M}"
VIDEO_MAXRATE="${YTWS_VIDEO_MAXRATE:-$VIDEO_BITRATE}"
VIDEO_BUFSIZE="${YTWS_VIDEO_BUFSIZE:-24M}"
VIDEO_GOP="${YTWS_VIDEO_GOP:-$((FPS * 2))}"
AUDIO_BITRATE="${YTWS_AUDIO_BITRATE:-128k}"
TEST_RTMP_PORT="${YTWS_TEST_RTMP_PORT:-19350}"
YOUTUBE_RTMPS_URL="${YTWS_YOUTUBE_RTMPS_URL:-rtmps://a.rtmps.youtube.com/live2}"
# Where `live` gets the stream key: the first line printed by a command, or a
# file only you can read. Without either it asks on the terminal.
STREAM_KEY_COMMAND="${YTWS_STREAM_KEY_COMMAND:-}"
STREAM_KEY_FILE="${YTWS_STREAM_KEY_FILE:-}"
NOTIFY="${YTWS_NOTIFY:-1}"
WALLPAPER="${YTWS_WALLPAPER:-$HOME/Pictures/background.jpg}"
CONFIGURED_VAAPI_DEVICE="${YTWS_VAAPI_DEVICE:-}"
MIRROR_BACKEND="${YTWS_MIRROR_BACKEND:-auto}"
PREVIEW_MONITOR="${YTWS_PREVIEW_MONITOR:-}"
# Layer surfaces (bars, notifications, launchers, ...) whose namespace does not
# match this pattern are painted black in the capture while a session runs.
STREAM_LAYERS="${YTWS_STREAM_LAYERS:-.*wallpaper.*|hyprpaper|swww-daemon|mpvpaper.*}"
# Windows whose class matches this pattern are painted black in the capture.
PRIVATE_WINDOWS="${YTWS_PRIVATE_WINDOWS-org\.keepassxc\.KeePassXC|KeePassXC|1[Pp]assword|[Bb]itwarden|com\.bitwarden\.desktop|gcr-prompter|org\.gnome\.seahorse\.Application}"

MIX_SINK="${YTWS_MIX_SINK:-yt_stream_mix}"
OUTPUT_SINK="${YTWS_OUTPUT_SINK:-yt_stream_output}"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/yt-stream-workspace"
STATE_FILE="$RUN_DIR/state"
SESSION_FILE="$RUN_DIR/session.lua"
PHASE_FILE="$RUN_DIR/phase"
CONTROL_FIFO="$RUN_DIR/control"
STATUS_FILE="$RUN_DIR/status"
REPLY_FILE="$RUN_DIR/reply"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt-stream-workspace"
SELF="$(readlink -f "$0")"

die() {
    printf 'workspace-stream: %s\n' "$*" >&2
    exit 1
}

note() {
    printf 'workspace-stream: %s\n' "$*"
}

usage() {
    cat <<EOF
Usage:
  workspace-stream start [WORKSPACE]   Isolate a workspace on the stream output
  workspace-stream stop                End the session and restore everything
  workspace-stream live                Go live on YouTube; reconnects on its own
  workspace-stream stop-live           Stop YouTube delivery, keep the session
  workspace-stream enter               Work in the stream workspace (Super+F11)
  workspace-stream leave               Return to the physical monitor (Super+F12)
  workspace-stream toggle              Enter or leave
  workspace-stream curtain [on|off]    Hide the stream picture and sound (Super+F10)
  workspace-stream workspace SELECTOR  Switch workspaces (for wrapper scripts)
  workspace-stream test [SECONDS]      Record locally and validate video and audio
  workspace-stream status [--json]     Show what the stream shows and its health
  workspace-stream logs                Show the persistent diagnostic log location
  workspace-stream doctor              Check prerequisites and configuration
  workspace-stream self-test           Run the automated integration test

WORKSPACE defaults to the active numeric Hyprland workspace. Viewers see only
the Hyprland output '$OUTPUT'. While a session runs, Hyprland itself keeps every
other workspace off that output, so ordinary workspace keys are safe.
EOF
}

require_commands() {
    local command
    for command in "$@"; do
        command -v "$command" >/dev/null 2>&1 ||
            die "required command is missing: $command"
    done
}

regex_is_valid() {
    local status=0
    # [[ =~ ]] returns 2, not 1, for a pattern that does not compile.
    # shellcheck disable=SC2319
    [[ "" =~ ^($1)$ ]] 2>/dev/null || status=$?
    (( status != 2 ))
}

validate_config() {
    [[ "$WIDTH" =~ ^[1-9][0-9]*$ ]] || die "YTWS_WIDTH must be a positive integer"
    [[ "$HEIGHT" =~ ^[1-9][0-9]*$ ]] || die "YTWS_HEIGHT must be a positive integer"
    [[ "$FPS" =~ ^[1-9][0-9]*$ ]] || die "YTWS_FPS must be a positive integer"
    [[ "$TEST_RTMP_PORT" =~ ^[1-9][0-9]*$ ]] || die "YTWS_TEST_RTMP_PORT must be a positive integer"
    [[ "$VIDEO_GOP" =~ ^[1-9][0-9]*$ ]] || die "YTWS_VIDEO_GOP must be a positive integer"
    (( WIDTH % 2 == 0 )) || die "YTWS_WIDTH must be even for H.264"
    (( HEIGHT % 2 == 0 )) || die "YTWS_HEIGHT must be even for H.264"
    (( FPS <= 60 )) || die "YTWS_FPS must not exceed YouTube's 60 fps limit"
    (( TEST_RTMP_PORT <= 65535 )) || die "YTWS_TEST_RTMP_PORT must be at most 65535"
    (( VIDEO_GOP <= FPS * 4 )) ||
        die "YTWS_VIDEO_GOP must not exceed four seconds ($((FPS * 4)) frames)"
    [[ "$SCALE" =~ ^([1-9][0-9]*(\.[0-9]+)?|0+\.[0-9]*[1-9][0-9]*)$ ]] ||
        die "YTWS_SCALE must be a positive number"
    [[ "$OUTPUT" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "YTWS_OUTPUT may contain only letters, numbers, dot, underscore, and hyphen"
    [[ "$MIX_SINK" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "YTWS_MIX_SINK may contain only letters, numbers, dot, underscore, and hyphen"
    [[ "$OUTPUT_SINK" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "YTWS_OUTPUT_SINK may contain only letters, numbers, dot, underscore, and hyphen"
    [[ -z "$PREVIEW_MONITOR" || "$PREVIEW_MONITOR" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "YTWS_PREVIEW_MONITOR must be a Hyprland monitor name"
    { [[ -n "$STREAM_LAYERS" && "$STREAM_LAYERS" != *[[:cntrl:]]* ]] &&
        regex_is_valid "$STREAM_LAYERS"; } ||
        die "YTWS_STREAM_LAYERS must be a regular expression"
    { [[ "$PRIVATE_WINDOWS" != *[[:cntrl:]]* ]] && regex_is_valid "$PRIVATE_WINDOWS"; } ||
        die "YTWS_PRIVATE_WINDOWS must be a regular expression"
    [[ "$NOTIFY" =~ ^[01]$ ]] || die "YTWS_NOTIFY must be 0 or 1"
    case "$MIRROR_BACKEND" in
    auto|extcopy-dmabuf|extcopy-shm|screencopy-dmabuf|screencopy-shm|export-dmabuf)
        ;;
    *)
        die "YTWS_MIRROR_BACKEND is not a supported wl-mirror backend"
        ;;
    esac
}

pid_is_alive() {
    local pid="${1:-}"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

pid_is_command() {
    local pid="${1:-}"
    local expected="${2:-}"
    local executable

    pid_is_alive "$pid" || return 1
    executable="$(readlink -f "/proc/$pid/exe" 2>/dev/null)" || return 1
    [[ "${executable##*/}" == "$expected" ]]
}

wait_until() {
    local description="$1"
    shift
    for _ in $(seq 1 100); do
        if "$@"; then
            return 0
        fi
        sleep 0.03
    done
    die "timed out waiting for $description"
}

port_is_listening() {
    local port="$1"
    ss -H -ltn | awk -v suffix=":$port" '$4 ~ suffix "$" { found=1 } END { exit !found }'
}

# Start a GUI helper outside the caller's process tree and print its PID.
# Hyprland's window swallowing hides a terminal behind any window started
# from it; a helper reparented away from the terminal never swallows it.
spawn_detached() {
    local log="$1"
    shift
    (setsid "$@" </dev/null >"$log" 2>&1 & printf '%s\n' "$!")
}

stop_pid() {
    local pid="${1:-}" name="$2"
    pid_is_command "$pid" "$name" || return 0
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
        pid_is_alive "$pid" || return 0
        sleep 0.02
    done
    kill -KILL "$pid" 2>/dev/null || true
}

# --- Hyprland module --------------------------------------------------------

lua_quote() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

# Evaluate Lua inside Hyprland and print what it returns.
hypr_call() {
    local result
    result="$(hyprctl repl "$1" 2>&1)" || {
        printf '%s\n' "$result" >&2
        return 1
    }
    [[ "$result" != error:* ]] || {
        printf '%s\n' "$result" >&2
        return 1
    }
    printf '%s\n' "$result"
}

module_protocol() {
    hyprctl repl 'return YTWS and YTWS.protocol or 0' 2>/dev/null || printf '0\n'
}

module_path() {
    local candidate
    for candidate in \
        "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/yt-stream-workspace.lua" \
        "${SELF%/bin/*}/hyprland/yt-stream-workspace.lua"; do
        [[ -r "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

ensure_module() {
    local protocol
    protocol="$(module_protocol)"
    if [[ "$protocol" == "$PROTOCOL" ]]; then
        return 0
    fi
    if [[ "$protocol" == 0 ]]; then
        die "Hyprland has not loaded yt-stream-workspace.lua; add require(\"yt-stream-workspace\") to hyprland.lua and run 'hyprctl reload'"
    fi
    die "Hyprland runs yt-stream-workspace.lua protocol $protocol but this command needs $PROTOCOL; update the module and run 'hyprctl reload'"
}

json_field() {
    jq -r --arg field "$2" '.[$field] // empty' <<<"$1"
}

write_intent() {
    umask 077
    {
        printf 'return {\n'
        printf '    protocol = %s,\n' "$PROTOCOL"
        printf '    output = %s,\n' "$(lua_quote "$OUTPUT")"
        printf '    workspace = %s,\n' "$WORKSPACE"
        printf '    mode = %s,\n' "$(lua_quote "${WIDTH}x${HEIGHT}@${FPS}")"
        printf '    scale = %s,\n' "$SCALE"
        printf '    preview_monitor = %s,\n' "$(lua_quote "$PREVIEW_MONITOR")"
        printf '    stream_layers = %s,\n' "$(lua_quote "($STREAM_LAYERS)")"
        printf '    private_windows = %s,\n' "$(lua_quote "${PRIVATE_WINDOWS:+($PRIVATE_WINDOWS)}")"
        printf '    mix_sink = %s,\n' "$(lua_quote "$MIX_SINK")"
        printf '}\n'
    } >"$SESSION_FILE"
}

phase_is() {
    local phase=""
    [[ -r "$PHASE_FILE" ]] && read -r phase <"$PHASE_FILE"
    [[ "$phase" == "$1" ]]
}

# --- compositor queries -----------------------------------------------------

output_exists() {
    hyprctl -j monitors | jq -e --arg output "$OUTPUT" \
        'any(.[]; .name == $output)' >/dev/null
}

output_matches_config() {
    hyprctl -j monitors | jq -e \
        --arg output "$OUTPUT" \
        --argjson width "$WIDTH" \
        --argjson height "$HEIGHT" \
        --argjson fps "$FPS" \
        --argjson scale "$SCALE" \
        'any(.[];
            .name == $output and
            .width == $width and
            .height == $height and
            ((.refreshRate - $fps) | fabs) < 0.1 and
            ((.scale - $scale) | fabs) < 0.001
        )' >/dev/null
}

output_absent() {
    ! output_exists
}

preview_window_mapped() {
    hyprctl -j clients | jq -e --argjson pid "$MIRROR_PID" --arg title "$PREVIEW_TITLE" \
        'any(.[]; .pid == $pid and .title == $title and .mapped)' >/dev/null
}

# --- session state ----------------------------------------------------------

load_state() {
    [[ -r "$STATE_FILE" ]] || die "no prepared stream session; run 'workspace-stream start' first"
    # The state file is mode 600 in a mode 700 per-user runtime directory.
    # shellcheck disable=SC1090
    source "$STATE_FILE"
}

write_state() {
    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    umask 077
    {
        # Snapshot session-defining config so later edits cannot strand resources.
        printf 'OUTPUT=%q\n' "$OUTPUT"
        printf 'WIDTH=%q\n' "$WIDTH"
        printf 'HEIGHT=%q\n' "$HEIGHT"
        printf 'FPS=%q\n' "$FPS"
        printf 'SCALE=%q\n' "$SCALE"
        printf 'VIDEO_BITRATE=%q\n' "$VIDEO_BITRATE"
        printf 'VIDEO_MAXRATE=%q\n' "$VIDEO_MAXRATE"
        printf 'VIDEO_BUFSIZE=%q\n' "$VIDEO_BUFSIZE"
        printf 'VIDEO_GOP=%q\n' "$VIDEO_GOP"
        printf 'AUDIO_BITRATE=%q\n' "$AUDIO_BITRATE"
        printf 'TEST_RTMP_PORT=%q\n' "$TEST_RTMP_PORT"
        printf 'YOUTUBE_RTMPS_URL=%q\n' "$YOUTUBE_RTMPS_URL"
        printf 'MIX_SINK=%q\n' "$MIX_SINK"
        printf 'OUTPUT_SINK=%q\n' "$OUTPUT_SINK"
        printf 'MIRROR_BACKEND=%q\n' "$MIRROR_BACKEND"
        printf 'WALLPAPER=%q\n' "$WALLPAPER"
        printf 'NOTIFY=%q\n' "$NOTIFY"
        printf 'LOG_DIR=%q\n' "$LOG_DIR"
        printf 'SIGNATURE=%q\n' "${SIGNATURE:-}"
        printf 'WORKSPACE=%q\n' "${WORKSPACE:-}"
        printf 'PREVIEW_ON=%q\n' "${PREVIEW_ON:-}"
        printf 'ORIGINAL_SINK=%q\n' "${ORIGINAL_SINK:-}"
        printf 'ORIGINAL_SOURCE=%q\n' "${ORIGINAL_SOURCE:-}"
        printf 'PREEXISTING_INPUTS=%q\n' "${PREEXISTING_INPUTS:-}"
        printf 'NULL_MODULE=%q\n' "${NULL_MODULE:-}"
        printf 'COMBINE_MODULE=%q\n' "${COMBINE_MODULE:-}"
        printf 'LOOPBACK_MODULE=%q\n' "${LOOPBACK_MODULE:-}"
        printf 'SUPERVISOR_PID=%q\n' "${SUPERVISOR_PID:-}"
        printf 'VAAPI_DEVICE=%q\n' "${VAAPI_DEVICE:-}"
    } >"$STATE_FILE"
}

# --- encoder ----------------------------------------------------------------

vaapi_device_works() {
    local device="$1"
    [[ -e "$device" ]] || return 1
    ffmpeg -hide_banner -loglevel error -vaapi_device "$device" \
        -f lavfi -i testsrc2=size=64x64:rate=1 -frames:v 1 \
        -vf format=nv12,hwupload -c:v h264_vaapi -f null - >/dev/null 2>&1
}

find_vaapi_device() {
    if [[ -n "$CONFIGURED_VAAPI_DEVICE" ]]; then
        vaapi_device_works "$CONFIGURED_VAAPI_DEVICE" || return 1
        VAAPI_DEVICE="$CONFIGURED_VAAPI_DEVICE"
        return 0
    fi

    local device
    for device in /dev/dri/renderD*; do
        [[ -e "$device" ]] || continue
        if vaapi_device_works "$device"; then
            VAAPI_DEVICE="$device"
            return 0
        fi
    done

    return 1
}

detect_vaapi_device() {
    require_commands ffmpeg
    if find_vaapi_device; then
        return
    fi
    if [[ -n "$CONFIGURED_VAAPI_DEVICE" ]]; then
        die "configured VAAPI device does not encode H.264: $CONFIGURED_VAAPI_DEVICE"
    fi
    die "no VAAPI render node can encode H.264; set YTWS_VAAPI_DEVICE if auto-detection missed it"
}

# --- audio ------------------------------------------------------------------

audio_start() {
    local input

    ORIGINAL_SINK="$(pactl get-default-sink)"
    ORIGINAL_SOURCE="$(pactl get-default-source)"
    PREEXISTING_INPUTS="$(
        pactl list short sink-inputs | awk '{print $1}' | paste -sd' ' -
    )"

    NULL_MODULE="$(
        pactl load-module module-null-sink \
            sink_name="$MIX_SINK" \
            sink_properties=device.description=YouTube_Stream_Mix \
            rate=48000 channels=2
    )"
    COMBINE_MODULE="$(
        pactl load-module module-combine-sink \
            sink_name="$OUTPUT_SINK" \
            sink_properties=device.description=YouTube_Stream_Output \
            sinks="$ORIGINAL_SINK,$MIX_SINK" \
            rate=48000 channels=2
    )"
    LOOPBACK_MODULE="$(
        pactl load-module module-loopback \
            source="$ORIGINAL_SOURCE" sink="$MIX_SINK" latency_msec=20
    )"

    pactl set-default-sink "$OUTPUT_SINK"
    for input in $PREEXISTING_INPUTS; do
        pactl move-sink-input "$input" "$OUTPUT_SINK" 2>/dev/null || true
    done
}

audio_stop() {
    local stream_sink_id input

    if [[ -n "${ORIGINAL_SINK:-}" ]]; then
        pactl set-default-sink "$ORIGINAL_SINK" 2>/dev/null || true
        stream_sink_id="$(
            pactl list short sinks 2>/dev/null |
                awk -v name="$OUTPUT_SINK" '$2 == name {print $1; exit}'
        )"
        if [[ -n "$stream_sink_id" ]]; then
            while read -r input; do
                [[ -n "$input" ]] || continue
                pactl move-sink-input "$input" "$ORIGINAL_SINK" 2>/dev/null || true
            done < <(
                pactl list short sink-inputs 2>/dev/null |
                    awk -v sink="$stream_sink_id" '$2 == sink {print $1}'
            )
        fi
    fi

    if [[ -n "${LOOPBACK_MODULE:-}" ]]; then
        pactl unload-module "$LOOPBACK_MODULE" 2>/dev/null || true
    fi
    if [[ -n "${COMBINE_MODULE:-}" ]]; then
        pactl unload-module "$COMBINE_MODULE" 2>/dev/null || true
    fi
    if [[ -n "${NULL_MODULE:-}" ]]; then
        pactl unload-module "$NULL_MODULE" 2>/dev/null || true
    fi
}

wf_recorder_args() {
    : "${VAAPI_DEVICE:?VAAPI_DEVICE is not set}"
    WF_ARGS=(
        -o "$OUTPUT"
        --no-damage
        -r "$FPS"
        -c h264_vaapi
        -d "$VAAPI_DEVICE"
        -p rc_mode=CBR
        -p "b=$VIDEO_BITRATE"
        -p "maxrate=$VIDEO_MAXRATE"
        -p "bufsize=$VIDEO_BUFSIZE"
        -p "g=$VIDEO_GOP"
        -p profile=high
        -b 2
        "--audio=$MIX_SINK.monitor"
        -C aac
        -P "b=$AUDIO_BITRATE"
        -R 48000
    )
}

# WirePlumber remembers a capture stream's mute by application name, so one
# recording muted from a mixer would silence every later one. Force ours open.
unmute_capture() {
    local index
    index="$(
        pactl -f json list source-outputs 2>/dev/null | jq -r --arg pid "$1" \
            'first(.[] | select(.properties["application.process.id"] == $pid) | .index) // empty'
    )"
    [[ -n "$index" ]] || return 1
    pactl set-source-output-mute "$index" 0 && pactl set-source-output-volume "$index" 100%
}

# --- session lifecycle ------------------------------------------------------

# A state file left behind by an earlier Hyprland instance describes nothing
# that still exists in this compositor; release its audio modules and drop it.
discard_stale_session() {
    [[ -r "$STATE_FILE" ]] || return 0
    local current="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    (
        load_state
        [[ -n "${SIGNATURE:-}" && "$SIGNATURE" != "$current" ]] || exit 3
        audio_stop
    ) && {
        rm -rf "$RUN_DIR"
        note "discarded a session left by an earlier Hyprland instance"
        return 0
    }
    die "a stream session is already prepared; run 'workspace-stream stop' first"
}

load_status() {
    MIRROR_STATE="" MIRROR_PID="" MIRROR_RESTARTS=0 WALLPAPER_PID=""
    LIVE_STATE="" LIVE_PID="" LIVE_SINCE="" LIVE_RECONNECTS=0 LIVE_KBPS=0 LIVE_ERROR=""
    if [[ -r "$STATUS_FILE" ]]; then
        # Written by this session's supervisor in the private runtime directory.
        # shellcheck disable=SC1090
        source "$STATUS_FILE"
    fi
}

supervisor_alive() {
    local pid="${SUPERVISOR_PID:-}" arg
    pid_is_alive "$pid" || return 1
    local -a cmdline=()
    mapfile -d '' cmdline <"/proc/$pid/cmdline" 2>/dev/null || return 1
    for arg in "${cmdline[@]}"; do
        [[ "$arg" == _supervise ]] && return 0
    done
    return 1
}

supervisor_ready() {
    load_status
    [[ "$MIRROR_STATE" == up && -n "$MIRROR_PID" ]]
}

# Send one command line to the supervisor and wait for its answer.
supervisor_send() {
    local seq="$$.$RANDOM" fd rseq message
    { supervisor_alive && [[ -p "$CONTROL_FIFO" ]]; } ||
        die "the session supervisor is not running; run 'workspace-stream stop' and start again"
    exec {fd}<>"$CONTROL_FIFO"
    printf '%s %s\n' "$seq" "$*" >&"$fd"
    exec {fd}>&-
    for _ in $(seq 1 200); do
        if [[ -r "$REPLY_FILE" ]] && read -r rseq message <"$REPLY_FILE" && [[ "$rseq" == "$seq" ]]; then
            SUPERVISOR_REPLY="$message"
            [[ "$message" == ok* ]]
            return
        fi
        sleep 0.05
    done
    die "the session supervisor did not answer"
}

stop_supervisor() {
    if supervisor_alive; then
        kill -TERM "$SUPERVISOR_PID" 2>/dev/null || true
        for _ in $(seq 1 200); do
            supervisor_alive || break
            sleep 0.05
        done
        supervisor_alive && kill -KILL "$SUPERVISOR_PID" 2>/dev/null
    fi
    # Whatever a supervisor that died left behind.
    load_status
    stop_pid "$LIVE_PID" wf-recorder
    stop_pid "$MIRROR_PID" wl-mirror
    stop_pid "$WALLPAPER_PID" swaybg
    # Sessions started before the supervisor recorded helpers in the state.
    stop_pid "${STATE_MIRROR_PID:-}" wl-mirror
    stop_pid "${STATE_LIVE_PID:-}" wf-recorder
}

abort_start() {
    note "start failed; restoring the desktop"
    stop_supervisor
    audio_stop
    hypr_call 'return YTWS and YTWS.finish() or ""' >/dev/null 2>&1 || true
    if output_exists; then
        hyprctl output remove "$OUTPUT" >/dev/null 2>&1 || true
    fi
    rm -rf "$RUN_DIR"
}

start_session() {
    validate_config
    require_commands hyprctl jq pactl wl-mirror wf-recorder ffmpeg ss setsid
    discard_stale_session
    ensure_module
    output_exists && die "Hyprland output '$OUTPUT' already exists"

    detect_vaapi_device
    WORKSPACE="${1:-$(hypr_call 'return hl.get_active_workspace().id')}"
    [[ "$WORKSPACE" =~ ^[1-9][0-9]*$ ]] ||
        die "workspace must be a positive numeric Hyprland workspace"

    SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    ORIGINAL_SINK="" ORIGINAL_SOURCE="" PREEXISTING_INPUTS=""
    NULL_MODULE="" COMBINE_MODULE="" LOOPBACK_MODULE=""
    SUPERVISOR_PID="" PREVIEW_ON=""

    mkdir -p "$RUN_DIR" "$LOG_DIR"
    chmod 700 "$RUN_DIR" "$LOG_DIR"
    write_intent
    write_state
    trap abort_start EXIT

    local result
    result="$(hypr_call 'return YTWS.begin()')" || die "Hyprland rejected the session"
    [[ "$(json_field "$result" ok)" == true ]] ||
        die "Hyprland rejected the session: $(json_field "$result" error)"
    PREVIEW_ON="$(json_field "$result" preview_monitor)"
    write_state

    hyprctl output create headless "$OUTPUT" >/dev/null
    wait_until "headless output" output_exists
    if ! phase_is active; then
        hypr_call 'return YTWS.activate()' >/dev/null
    fi
    wait_until "stream workspace activation" phase_is active
    wait_until "configured output mode" output_matches_config

    audio_start
    # WirePlumber restores a sink's volume and mute by name, so a session that
    # ended with the curtain up would otherwise start silent.
    if ! { pactl set-sink-mute "$MIX_SINK" 0 && pactl set-sink-volume "$MIX_SINK" 100% &&
           pactl set-source-mute "$MIX_SINK.monitor" 0 &&
           pactl set-source-volume "$MIX_SINK.monitor" 100%; }; then
        die "could not reset the stream mix volume"
    fi
    write_state

    SUPERVISOR_PID="$(spawn_detached "$LOG_DIR/supervisor.log" "$SELF" _supervise)"
    write_state
    wait_until "session supervisor" supervisor_ready
    wait_until "preview window" preview_window_mapped

    trap - EXIT
    note "workspace $WORKSPACE is isolated on $OUTPUT (${WIDTH}x${HEIGHT}@${FPS}, scale $SCALE)"
    note "the preview is on $PREVIEW_ON; Super+F11 works in the stream, Super+F12 returns"
    note "Super+F10 raises the curtain; run 'workspace-stream test' before going live"
}

stop_session_internal() {
    stop_supervisor
    audio_stop

    if [[ "$(module_protocol)" == "$PROTOCOL" ]]; then
        hypr_call 'return YTWS.finish()' >/dev/null || true
    elif output_exists; then
        # Without the module, at least bring the workspace home before the
        # output disappears and Hyprland picks a monitor for it.
        hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$WORKSPACE\", monitor = \"${PREVIEW_ON:-${ORIGINAL_MONITOR:-}}\" })" \
            >/dev/null 2>&1 || true
    fi

    if output_exists; then
        hyprctl output remove "$OUTPUT" >/dev/null 2>&1 || true
        for _ in $(seq 1 100); do
            output_exists || break
            sleep 0.03
        done
        if output_exists; then
            note "could not remove stream output '$OUTPUT'; preserving state for recovery"
            return 1
        fi
    fi
    rm -rf "$RUN_DIR"
}

stop_session() {
    load_state
    # Sessions started before the supervisor kept helper PIDs in the state.
    STATE_MIRROR_PID="${MIRROR_PID:-}" STATE_LIVE_PID="${LIVE_PID:-}"
    stop_session_internal
    note "workspace, audio, preview, and virtual output restored"
}

# --- supervisor -------------------------------------------------------------
#
# Each session has one detached supervisor that owns the preview and live
# delivery. It restarts a preview that dies, reconnects YouTube with backoff,
# notices a connection that has stalled, keeps the recorder's audio capture
# open, and records what it sees in $RUN_DIR/status. Commands arrive as
# "SEQ COMMAND [ARGUMENT]" lines on the $RUN_DIR/control FIFO, so the stream
# key never appears in a command line or a file; answers go to
# $RUN_DIR/reply. Every check is a shell builtin: an idle tick forks nothing.

LIVE_CONNECTED_BYTES="${YTWS_LIVE_CONNECTED_BYTES:-262144}"         # acknowledged before an attempt counts as connected
LIVE_ESTABLISHED_SECONDS="${YTWS_LIVE_ESTABLISHED_SECONDS:-10}"     # connected this long: YouTube accepted it
LIVE_STALL_SECONDS="${YTWS_LIVE_STALL_SECONDS:-10}"                 # connected but nothing acknowledged this long: dead
LIVE_CONNECT_SECONDS="${YTWS_LIVE_CONNECT_SECONDS:-20}"             # not connected by now: the attempt failed
LIVE_REFUSED_LIMIT=3        # attempts in a row that never establish
MIRROR_RESTART_LIMIT=5      # preview restarts within a minute before giving up

# Sleep without forking and without reading the command FIFO, so commands
# that arrive while the supervisor waits stay queued for the main loop.
sup_sleep() {
    read -r -t "$1" -u "$SUP_SLEEP" _ || true
}

notify_user() {
    [[ "$NOTIFY" == 1 ]] && command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "YouTube stream" "$@" >/dev/null 2>&1 &
}

sup_log() {
    printf '%(%F %T)T %s\n' -1 "$*"
}

sup_write_status() {
    printf '%s\n' \
        "SUPERVISOR_PID=$$" \
        "MIRROR_STATE=$MIRROR_STATE" \
        "MIRROR_PID=$MIRROR_PID" \
        "MIRROR_RESTARTS=$MIRROR_RESTARTS" \
        "WALLPAPER_PID=$WALLPAPER_PID" \
        "LIVE_STATE=$LIVE_STATE" \
        "LIVE_PID=$LIVE_PID" \
        "LIVE_SINCE=$LIVE_SINCE" \
        "LIVE_RECONNECTS=$LIVE_RECONNECTS" \
        "LIVE_KBPS=$LIVE_KBPS" \
        "LIVE_ERROR=${LIVE_ERROR@Q}" \
        "STATUS_TIME=$EPOCHSECONDS" >"$STATUS_FILE"
}

sup_reply() {
    printf '%s %s\n' "$1" "$2" >"$REPLY_FILE"
}

sup_set_live() {
    hyprctl eval "if YTWS then YTWS.set_live($1) end" >/dev/null 2>&1 || true
}

# Bytes the far end has acknowledged on PID's established TCP connections.
# This is delivery, not buffering: it stops growing when the network does,
# even while the recorder keeps filling its socket buffer. (/proc/PID/io
# would miss it entirely: ffmpeg sends with send(2), which wchar does not
# count.)
socket_acked() {
    # Locals are prefixed: printf -v below assigns through the caller's name,
    # and a local of the same name would capture the result.
    local _sa_pid="$1" _sa_line _sa_mine=0 _sa_total=0 _sa_found=1 _sa_value
    while IFS= read -r _sa_line; do
        if [[ "$_sa_line" != [[:space:]]* ]]; then
            _sa_mine=0
            [[ "$_sa_line" == *"pid=$_sa_pid,"* ]] && _sa_mine=1
        elif (( _sa_mine )) && [[ "$_sa_line" == *bytes_acked:* ]]; then
            _sa_value="${_sa_line#*bytes_acked:}"
            _sa_value="${_sa_value%% *}"
            if [[ "$_sa_value" =~ ^[0-9]+$ ]]; then
                _sa_total=$((_sa_total + _sa_value))
                _sa_found=0
            fi
        fi
    done < <(ss -Htinp state established 2>/dev/null)
    printf -v "$2" '%s' "$_sa_total"
    return "$_sa_found"
}

sup_mirror_start() {
    wl-mirror --backend "$MIRROR_BACKEND" --show-cursor --scaling fit \
        --title "$PREVIEW_TITLE" "$OUTPUT" </dev/null >>"$LOG_DIR/wl-mirror.log" 2>&1 &
    MIRROR_PID=$!
    MIRROR_STATE=up
    sup_log "preview started (pid $MIRROR_PID)"
}

sup_mirror_check() {
    [[ "$MIRROR_STATE" == up ]] || return 0
    pid_is_alive "$MIRROR_PID" && return 0
    local status=0 t
    wait "$MIRROR_PID" 2>/dev/null || status=$?
    sup_log "preview exited with status $status"
    local -a recent=()
    for t in "${MIRROR_FAILURES[@]}" "$EPOCHSECONDS"; do
        (( EPOCHSECONDS - t < 60 )) && recent+=("$t")
    done
    MIRROR_FAILURES=("${recent[@]}")
    if (( ${#MIRROR_FAILURES[@]} > MIRROR_RESTART_LIMIT )); then
        MIRROR_STATE=failed
        MIRROR_PID=""
        notify_user -u critical "Stream preview keeps failing" \
            "The stream itself is unaffected. See $LOG_DIR/wl-mirror.log."
        return 0
    fi
    MIRROR_RESTARTS=$((MIRROR_RESTARTS + 1))
    sup_mirror_start
}

# wf-recorder prints the URL it publishes to; keep the key out of the log.
sup_redact() {
    local line
    while IFS= read -r line; do
        printf '%(%F %T)T %s\n' -1 "${line//"$SUP_KEY"/<stream key>}"
    done
}

sup_live_attempt() {
    wf_recorder_args
    wf-recorder "${WF_ARGS[@]}" -f "${YOUTUBE_RTMPS_URL%/}/$SUP_KEY" </dev/null \
        > >(sup_redact >>"$LOG_DIR/live.log") 2>&1 &
    LIVE_PID=$!
    LIVE_ATTEMPT_AT=$EPOCHSECONDS
    LIVE_PROGRESS_AT=$EPOCHSECONDS
    LIVE_CONNECTED_AT=""
    LIVE_ACKED=0
    LIVE_SAMPLE_US=${EPOCHREALTIME/./}
    LIVE_UNMUTED=0
    LIVE_ESTABLISHED=0
    [[ "$LIVE_STATE" == reconnecting ]] || LIVE_STATE=connecting
    sup_log "connecting to YouTube (pid $LIVE_PID)"
}

sup_live_give_up() {
    sup_log "giving up: $1"
    LIVE_WANTED=0
    LIVE_STATE=failed
    LIVE_ERROR="$1"
    LIVE_KBPS=0
    SUP_KEY=""
    sup_set_live false
    notify_user -u critical "Not live on YouTube" "$1"
}

sup_live_ended() {
    sup_log "$1"
    LIVE_PID=""
    LIVE_KBPS=0
    (( LIVE_WANTED )) || { LIVE_STATE=offline; return 0; }
    if (( LIVE_ESTABLISHED )); then
        LIVE_FAILURES=0
    else
        LIVE_FAILURES=$((LIVE_FAILURES + 1))
        if (( LIVE_FAILURES >= LIVE_REFUSED_LIMIT )); then
            sup_live_give_up "YouTube did not accept the stream $LIVE_FAILURES times in a row; check the stream key and that a broadcast is waiting for it"
            return 0
        fi
    fi
    if [[ "$LIVE_STATE" == live ]]; then
        LIVE_RECONNECTS=$((LIVE_RECONNECTS + 1))
        notify_user -u critical "Stream connection lost" "Reconnecting to YouTube..."
    fi
    LIVE_ERROR="$1"
    LIVE_STATE=reconnecting
    local delay=$((1 << (LIVE_FAILURES < 3 ? LIVE_FAILURES : 3)))
    LIVE_RETRY_AT=$((EPOCHSECONDS + delay))
}

# wf-recorder finishes the stream cleanly on TERM as on INT, and TERM, unlike
# INT, is not ignored by processes a script starts in the background.
sup_live_kill() {
    local pid="$1" status=0
    kill -TERM "$pid" 2>/dev/null || return 0
    for _ in {1..50}; do
        pid_is_alive "$pid" || break
        sup_sleep 0.1
    done
    pid_is_alive "$pid" && kill -KILL "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null || status=$?
    return 0
}

sup_live_check() {
    (( LIVE_WANTED )) || return 0
    if [[ -z "$LIVE_PID" ]]; then
        (( EPOCHSECONDS >= LIVE_RETRY_AT )) && sup_live_attempt
        return 0
    fi
    if ! pid_is_alive "$LIVE_PID"; then
        local status=0
        wait "$LIVE_PID" 2>/dev/null || status=$?
        sup_live_ended "wf-recorder exited with status $status"
        return 0
    fi

    local acked=$LIVE_ACKED now=$EPOCHSECONDS now_us=${EPOCHREALTIME/./}
    socket_acked "$LIVE_PID" acked || acked=$LIVE_ACKED
    (( acked >= LIVE_ACKED )) || LIVE_ACKED=0 # a new connection inside the same recorder
    if (( now_us - LIVE_SAMPLE_US >= 1000000 )); then
        local kbps=$(( (acked - LIVE_ACKED) * 8000 / (now_us - LIVE_SAMPLE_US) ))
        LIVE_KBPS=$(( LIVE_KBPS > 0 ? (LIVE_KBPS * 3 + kbps) / 4 : kbps ))
        (( acked > LIVE_ACKED )) && LIVE_PROGRESS_AT=$now
        LIVE_ACKED=$acked
        LIVE_SAMPLE_US=$now_us
    fi

    if (( !LIVE_UNMUTED && now - LIVE_ATTEMPT_AT >= 1 )); then
        unmute_capture "$LIVE_PID" && LIVE_UNMUTED=1
    fi

    if [[ -z "$LIVE_CONNECTED_AT" ]] && (( acked >= LIVE_CONNECTED_BYTES )); then
        LIVE_CONNECTED_AT=$now
        if [[ "$LIVE_STATE" == reconnecting ]]; then
            notify_user "Reconnected to YouTube" "The stream is live again."
        else
            notify_user "You are live on YouTube"
        fi
        LIVE_STATE=live
        LIVE_SINCE=${LIVE_SINCE:-$now}
        LIVE_ERROR=""
        sup_log "live"
    fi
    if [[ -n "$LIVE_CONNECTED_AT" ]] && (( !LIVE_ESTABLISHED && now - LIVE_CONNECTED_AT >= LIVE_ESTABLISHED_SECONDS )); then
        LIVE_ESTABLISHED=1
        LIVE_FAILURES=0
    fi

    if [[ -n "$LIVE_CONNECTED_AT" ]] && (( now - LIVE_PROGRESS_AT >= LIVE_STALL_SECONDS )); then
        sup_live_kill "$LIVE_PID"
        sup_live_ended "the connection stalled: nothing delivered for ${LIVE_STALL_SECONDS}s"
    elif [[ -z "$LIVE_CONNECTED_AT" ]] && (( now - LIVE_ATTEMPT_AT >= LIVE_CONNECT_SECONDS )); then
        sup_live_kill "$LIVE_PID"
        sup_live_ended "could not connect to YouTube within ${LIVE_CONNECT_SECONDS}s"
    fi
}

sup_live_stop() {
    LIVE_WANTED=0
    if [[ -n "$LIVE_PID" ]]; then
        sup_live_kill "$LIVE_PID"
        sup_log "stopped live delivery"
    fi
    LIVE_PID=""
    LIVE_STATE=offline
    LIVE_KBPS=0
    SUP_KEY=""
    sup_set_live false
}

sup_command() {
    local seq cmd arg
    read -r seq cmd arg <<<"$1"
    case "$cmd" in
    ping)
        sup_reply "$seq" ok
        ;;
    live)
        if (( LIVE_WANTED )); then
            sup_reply "$seq" "error: already $LIVE_STATE"
            return 0
        fi
        if [[ ! "$arg" =~ ^[A-Za-z0-9_-]{4,128}$ ]]; then
            sup_reply "$seq" "error: that does not look like a YouTube stream key"
            return 0
        fi
        SUP_KEY="$arg"
        LIVE_WANTED=1 LIVE_FAILURES=0 LIVE_RECONNECTS=0 LIVE_SINCE="" LIVE_ERROR="" LIVE_KBPS=0
        LIVE_STATE=connecting
        sup_set_live true
        sup_live_attempt
        sup_reply "$seq" ok
        ;;
    offline)
        sup_live_stop
        sup_reply "$seq" ok
        ;;
    *)
        sup_reply "$seq" "error: unknown command"
        ;;
    esac
}

supervise_session() {
    # A long-lived process must not die on one failed command: every failure
    # below is handled where it happens, so errexit would only turn a hiccup
    # into a dropped stream.
    set +e +o pipefail
    trap - ERR
    load_state
    exec </dev/null
    exec {SUP_SLEEP}<> <(:)
    MIRROR_STATE=stopped MIRROR_PID="" MIRROR_RESTARTS=0 MIRROR_FAILURES=() WALLPAPER_PID=""
    LIVE_STATE=offline LIVE_PID="" LIVE_SINCE="" LIVE_RECONNECTS=0 LIVE_KBPS=0 LIVE_ERROR=""
    LIVE_WANTED=0 LIVE_FAILURES=0 LIVE_RETRY_AT=0 SUP_KEY=""
    : >"$LOG_DIR/live.log"

    rm -f "$CONTROL_FIFO"
    mkfifo -m 600 "$CONTROL_FIFO"
    exec {SUP_CTL}<>"$CONTROL_FIFO"
    SUP_RUNNING=1
    trap 'SUP_RUNNING=0' TERM INT HUP
    local socket="${XDG_RUNTIME_DIR:-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket.sock"

    if command -v swaybg >/dev/null 2>&1 && [[ -f "$WALLPAPER" ]]; then
        swaybg -o "$OUTPUT" -i "$WALLPAPER" </dev/null >"$LOG_DIR/swaybg.log" 2>&1 &
        WALLPAPER_PID=$!
    fi
    sup_mirror_start
    sup_write_status
    sup_log "supervising workspace $WORKSPACE on $OUTPUT"

    local line phase
    while (( SUP_RUNNING )); do
        if read -r -t 1 -u "$SUP_CTL" line; then
            sup_command "$line"
        fi
        (( SUP_RUNNING )) || break
        if [[ ! -S "$socket" ]]; then
            sup_log "Hyprland has gone away"
            break
        fi
        phase=""
        read -r phase 2>/dev/null <"$PHASE_FILE" || true
        if [[ "$phase" == lost ]] && (( LIVE_WANTED )); then
            sup_live_stop
            sup_live_give_up "the stream output disappeared"
        fi
        sup_mirror_check
        sup_live_check
        sup_write_status
    done

    sup_live_stop
    MIRROR_STATE=stopped
    [[ -n "$MIRROR_PID" ]] && kill "$MIRROR_PID" 2>/dev/null
    [[ -n "$WALLPAPER_PID" ]] && kill "$WALLPAPER_PID" 2>/dev/null
    wait 2>/dev/null
    MIRROR_PID="" WALLPAPER_PID=""
    LIVE_STATE=offline
    sup_write_status
    rm -f "$CONTROL_FIFO"
    sup_log "supervisor stopped"
}

# --- input handoff and curtain ----------------------------------------------

module_action() {
    local code="$1"
    hyprctl eval "if YTWS then $code end" >/dev/null
}

switch_workspace() {
    local selector="${1:?missing workspace selector}"
    [[ "$selector" =~ ^[A-Za-z0-9:+~_.-]+$ ]] || die "unsupported workspace selector: $selector"
    local q
    q="$(lua_quote "$selector")"
    # One round trip: the module's safe switch when it is loaded, a plain
    # dispatch otherwise.
    hyprctl eval "if YTWS then YTWS.workspace($q) else hl.dispatch(hl.dsp.focus({ workspace = $q })) end" >/dev/null
}

set_curtain() {
    local want
    case "${1:-}" in
    on) want=true ;;
    off) want=false ;;
    "") want=nil ;;
    *) die "curtain takes 'on', 'off', or nothing to toggle" ;;
    esac
    load_state
    ensure_module
    local result
    result="$(hypr_call "return YTWS.curtain($want)")"
    [[ "$(json_field "$result" ok)" == true ]] || die "the curtain did not change: $result"
    if [[ "$(json_field "$result" curtain)" == true ]]; then
        note "curtain up: viewers see the curtain and hear nothing"
    else
        note "curtain down: viewers see workspace $WORKSPACE"
    fi
}

# --- validation, live, status -----------------------------------------------

test_file() {
    local file="$1"
    local probe video_ok audio_ok volume

    probe="$(
        ffprobe -v error -show_entries \
            stream=codec_type,codec_name,width,height,r_frame_rate,sample_rate,channels \
            -of json "$file"
    )"
    printf '%s\n' "$probe" | jq .

    video_ok="$(
        printf '%s\n' "$probe" | jq -r --argjson width "$WIDTH" \
            --argjson height "$HEIGHT" \
            --arg rate "$FPS/1" \
            '[.streams[] | select(.codec_type == "video" and
              .codec_name == "h264" and .width == $width and .height == $height and
              .r_frame_rate == $rate)]
             | length'
    )"
    audio_ok="$(
        printf '%s\n' "$probe" | jq -r \
            '[.streams[] | select(.codec_type == "audio" and
              .codec_name == "aac" and .sample_rate == "48000" and .channels == 2)]
             | length'
    )"
    [[ "$video_ok" -ge 1 ]] || die "captured file failed video validation"
    [[ "$audio_ok" -ge 1 ]] || die "captured file failed audio validation"

    volume="$(
        ffmpeg -hide_banner -i "$file" -map 0:a:0 \
            -af volumedetect -f null - 2>&1 |
            awk '/mean_volume:/ {print $5; exit}'
    )"
    [[ -n "$volume" && "$volume" != "-inf" ]] ||
        die "captured audio stream is silent"
    note "audio signal detected (mean volume: $volume dB)"
}

run_local_rtmp_test() {
    validate_config
    load_state
    load_status
    require_commands ffmpeg ffprobe
    case "${LIVE_STATE:-offline}" in
    offline|failed) ;;
    *) die "YouTube delivery is $LIVE_STATE; stop it before a local test" ;;
    esac
    output_exists || die "stream output is missing"

    local seconds="${1:-5}"
    if [[ ! "$seconds" =~ ^[1-9][0-9]*$ ]] || (( seconds < 2 )); then
        die "test duration must be at least 2 whole seconds"
    fi
    local received
    received="/tmp/yt-stream-workspace-test-$(date +%Y%m%d-%H%M%S).flv"
    local url="rtmp://127.0.0.1:$TEST_RTMP_PORT/live/test"
    mkdir -p "$LOG_DIR"
    chmod 700 "$LOG_DIR"
    local receiver_log="$LOG_DIR/rtmp-receiver.log"
    local sender_log="$LOG_DIR/rtmp-sender.log"
    local receiver_pid tone_pid sender_pid status

    port_is_listening "$TEST_RTMP_PORT" &&
        die "TCP port $TEST_RTMP_PORT is already in use"

    ffmpeg -hide_banner -loglevel warning -listen 1 -i "$url" \
        -c copy -y "$received" >"$receiver_log" 2>&1 &
    receiver_pid=$!
    wait_until "local RTMP receiver" port_is_listening "$TEST_RTMP_PORT"

    ffmpeg -hide_banner -loglevel error -f lavfi \
        -i "sine=frequency=880:sample_rate=48000:duration=$seconds" \
        -af volume=0.08 -f pulse -device "$MIX_SINK" \
        yt-stream-workspace-test-tone >/dev/null 2>&1 &
    tone_pid=$!

    wf_recorder_args
    wf-recorder "${WF_ARGS[@]}" -f "$url" >"$sender_log" 2>&1 &
    sender_pid=$!
    sleep 1
    unmute_capture "$sender_pid" || true
    sleep "$((seconds - 1))"
    kill -TERM "$sender_pid" 2>/dev/null || true
    status=0
    wait "$sender_pid" || status=$?
    (( status == 0 || status == 143 )) || {
        kill "$receiver_pid" "$tone_pid" 2>/dev/null || true
        die "wf-recorder failed; see $sender_log"
    }
    wait "$tone_pid" 2>/dev/null || true

    for _ in $(seq 1 50); do
        pid_is_alive "$receiver_pid" || break
        sleep 0.1
    done
    if pid_is_alive "$receiver_pid"; then
        kill -INT "$receiver_pid" 2>/dev/null || true
    fi
    wait "$receiver_pid" 2>/dev/null || true

    [[ -s "$received" ]] || die "the local RTMP receiver produced no data"
    test_file "$received"
    note "local RTMP test passed: $received"
}

# Print the stream key from YTWS_STREAM_KEY_COMMAND, YTWS_STREAM_KEY_FILE, or a
# prompt, in that order.
read_stream_key() {
    local key="" mode
    if [[ -n "$STREAM_KEY_COMMAND" ]]; then
        IFS= read -r key < <(bash -c "$STREAM_KEY_COMMAND") ||
            [[ -n "$key" ]] || die "YTWS_STREAM_KEY_COMMAND printed nothing"
    elif [[ -n "$STREAM_KEY_FILE" ]]; then
        [[ -r "$STREAM_KEY_FILE" ]] || die "cannot read YTWS_STREAM_KEY_FILE: $STREAM_KEY_FILE"
        mode="$(stat -c %a "$STREAM_KEY_FILE")"
        (( (8#$mode & 8#077) == 0 )) ||
            die "$STREAM_KEY_FILE is readable by others; run: chmod 600 $STREAM_KEY_FILE"
        IFS= read -r key <"$STREAM_KEY_FILE" || [[ -n "$key" ]] || die "$STREAM_KEY_FILE is empty"
    else
        [[ -t 0 ]] ||
            die "no terminal to ask for the stream key; set YTWS_STREAM_KEY_COMMAND or YTWS_STREAM_KEY_FILE"
        read -r -s -p "YouTube stream key: " key
        printf '\n' >&2
    fi
    key="${key//[[:space:]]/}"
    [[ "$key" =~ ^[A-Za-z0-9_-]{4,128}$ ]] || die "that does not look like a YouTube stream key"
    printf '%s' "$key"
}

format_duration() {
    local s=$1
    if (( s >= 3600 )); then
        printf '%d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
    else
        printf '%d:%02d' $((s / 60)) $((s % 60))
    fi
}

start_live() {
    validate_config
    load_state
    load_status
    ensure_module
    supervisor_alive || die "the session supervisor is not running; run 'workspace-stream stop' and start again"
    case "${LIVE_STATE:-offline}" in
    offline|failed) ;;
    *) die "YouTube delivery is already $LIVE_STATE" ;;
    esac
    phase_is active || die "the stream workspace is not isolated; run 'workspace-stream status'"
    local host="${YOUTUBE_RTMPS_URL#*://}"
    host="${host%%[/:]*}"
    getent hosts "$host" >/dev/null || die "cannot resolve $host; check the network connection"

    local key
    key="$(read_stream_key)"
    supervisor_send live "$key" || die "could not go live: ${SUPERVISOR_REPLY#error: }"
    unset key
    note "connecting to YouTube..."
    for _ in $(seq 1 120); do
        load_status
        case "$LIVE_STATE" in
        live)
            note "live on YouTube; delivery reconnects by itself if the network drops"
            return 0
            ;;
        failed)
            die "not live: $LIVE_ERROR"
            ;;
        esac
        sleep 0.25
    done
    note "still connecting (${LIVE_ERROR:-no data sent yet}); 'workspace-stream status' shows progress"
}

stop_live() {
    load_state
    supervisor_send offline || die "could not stop delivery: $SUPERVISOR_REPLY"
    note "YouTube delivery stopped; the isolated workspace remains available"
}

describe_live() {
    local now=$EPOCHSECONDS
    case "${LIVE_STATE:-offline}" in
    live)
        printf 'live for %s at %s.%s Mbit/s' "$(format_duration $((now - ${LIVE_SINCE:-$now})))" \
            $((LIVE_KBPS / 1000)) $((LIVE_KBPS % 1000 / 100))
        (( LIVE_RECONNECTS == 0 )) || printf ', %s reconnect(s)' "$LIVE_RECONNECTS"
        ;;
    connecting) printf 'connecting' ;;
    reconnecting) printf 'reconnecting (%s)' "${LIVE_ERROR:-connection lost}" ;;
    failed) printf 'not live: %s' "$LIVE_ERROR" ;;
    *) printf 'offline' ;;
    esac
}

show_status() {
    local json=0
    [[ "${1:-}" == --json ]] && json=1
    if [[ ! -r "$STATE_FILE" ]]; then
        if (( json )); then
            printf '{"session":false}\n'
        else
            note "not prepared"
        fi
        return
    fi
    load_state
    load_status
    local status="" supervisor=false
    supervisor_alive && supervisor=true
    if [[ "$(module_protocol)" == "$PROTOCOL" ]]; then
        status="$(hypr_call 'return YTWS.status()' 2>/dev/null || true)"
    fi
    if (( json )); then
        jq -n --argjson guard "${status:-null}" --argjson supervisor "$supervisor" \
            --arg workspace "$WORKSPACE" --arg output "$OUTPUT" \
            --arg live "${LIVE_STATE:-offline}" --arg since "${LIVE_SINCE:-}" \
            --arg kbps "${LIVE_KBPS:-0}" --arg reconnects "${LIVE_RECONNECTS:-0}" \
            --arg error "${LIVE_ERROR:-}" --arg preview "${MIRROR_STATE:-}" '
            {session: true, workspace: ($workspace | tonumber), output: $output,
             supervisor: $supervisor, preview: $preview,
             live: {state: $live, since: ($since | if . == "" then null else tonumber end),
                    kbps: ($kbps | tonumber), reconnects: ($reconnects | tonumber),
                    error: (if $error == "" then null else $error end)},
             guard: $guard}'
        return
    fi
    printf 'workspace:      %s on %s (%sx%s@%s scale %s)\n' \
        "$WORKSPACE" "$OUTPUT" "$WIDTH" "$HEIGHT" "$FPS" "$SCALE"
    printf 'YouTube:        %s\n' "$(describe_live)"
    if [[ -n "$status" ]]; then
        jq -r --arg layers "^($STREAM_LAYERS)$" '
            "guard:          \(.phase), \(.corrections) correction(s)" +
                (if .last_correction then " (last: \(.last_correction))" else "" end),
            "stream shows:   \(.showing // "nothing")" +
                (if .curtain then " (curtain up)" else "" end),
            "you are:        " + (if .entered then "working in the stream" else "on \(.preview_monitor)" end),
            "on the output:  " + ((.layers // []) | map(. + (if test($layers) then "" else " (hidden)" end)) | join(", ")),
            (if .errors > 0 then "module errors:  \(.errors) (last: \(.last_error))" else empty end)
        ' <<<"$status"
    else
        printf 'guard:          not loaded in Hyprland\n'
    fi
    local preview="${MIRROR_STATE:-down}"
    [[ "$preview" == up ]] && preview="up on $PREVIEW_ON"
    (( ${MIRROR_RESTARTS:-0} == 0 )) || preview+=" (restarted ${MIRROR_RESTARTS}x)"
    printf 'preview:        %s\n' "$preview"
    printf 'supervisor:     %s\n' "$([[ "$supervisor" == true ]] && echo running || echo "not running; run 'workspace-stream stop'")"
    printf 'VAAPI device:   %s\n' "${VAAPI_DEVICE:-unknown}"
    printf 'logs:           %s\n' "$LOG_DIR"
}

show_logs() {
    printf '%s\n' "$LOG_DIR"
    if [[ -d "$LOG_DIR" ]]; then
        find "$LOG_DIR" -maxdepth 1 -type f -printf '%TY-%Tm-%Td %TH:%TM  %f\n' |
            sort -r
    else
        note "no diagnostic logs have been written"
    fi
}

# --- doctor -----------------------------------------------------------------

doctor_check_command() {
    local command="$1"
    if command -v "$command" >/dev/null 2>&1; then
        printf 'ok   command: %s\n' "$command"
    else
        printf 'miss command: %s\n' "$command"
        DOCTOR_FAILED=1
    fi
}

doctor_check_optional_command() {
    local command="$1"
    local reason="$2"
    if command -v "$command" >/dev/null 2>&1; then
        printf 'ok   optional: %s\n' "$command"
    else
        printf 'skip optional: %s (%s)\n' "$command" "$reason"
    fi
}

run_doctor() {
    validate_config
    DOCTOR_FAILED=0

    printf 'yt-stream-workspace doctor\n'
    printf 'config: %s\n' "$CONFIG_FILE"
    printf 'target output: %s %sx%s@%s scale %s\n' "$OUTPUT" "$WIDTH" "$HEIGHT" "$FPS" "$SCALE"
    printf 'mirror backend: %s\n' "$MIRROR_BACKEND"
    printf 'logs: %s\n' "$LOG_DIR"

    local command
    for command in hyprctl jq pactl wl-mirror wf-recorder ffmpeg ffprobe ss setsid getent; do
        doctor_check_command "$command"
    done
    doctor_check_optional_command swaybg "only needed for virtual-output wallpaper"
    doctor_check_optional_command notify-send "desktop notifications about live delivery"
    doctor_check_optional_command kitty "needed by self-test"
    doctor_check_optional_command wtype "needed by self-test"

    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        printf 'ok   Hyprland session detected\n'
    else
        printf 'warn HYPRLAND_INSTANCE_SIGNATURE is not set; run this inside Hyprland\n'
        DOCTOR_FAILED=1
    fi

    if command -v hyprctl >/dev/null 2>&1 && hyprctl -j monitors >/dev/null 2>&1; then
        printf 'ok   hyprctl monitor query works\n'
        local protocol
        protocol="$(module_protocol)"
        if [[ "$protocol" == "$PROTOCOL" ]]; then
            printf 'ok   Hyprland has loaded the stream guard module\n'
        elif [[ "$protocol" == 0 ]]; then
            printf 'miss Hyprland has not loaded yt-stream-workspace.lua; add require("yt-stream-workspace") to hyprland.lua\n'
            DOCTOR_FAILED=1
        else
            printf 'miss Hyprland runs module protocol %s, this command needs %s; run hyprctl reload\n' \
                "$protocol" "$PROTOCOL"
            DOCTOR_FAILED=1
        fi
        local bound
        bound="$(
            hyprctl -j workspacerules 2>/dev/null | jq -r '
                .[] | select(.enabled != false and (.monitor // "") != "" and
                             (.workspaceString | test("^[0-9]+$")))
                | "\(.workspaceString) -> \(.monitor)"' 2>/dev/null || true
        )"
        if [[ -n "$bound" ]]; then
            printf 'warn these workspaces are bound to monitors by your rules; stream another one:\n'
            printf '       %s\n' "${bound//$'\n'/$'\n       '}"
        fi
        if [[ -n "$(hyprctl configerrors 2>/dev/null | tr -d '[:space:]')" ]]; then
            printf 'warn Hyprland reports config errors; its error banner is drawn on the focused monitor, which can be the stream\n'
        fi
    else
        printf 'miss hyprctl monitor query failed\n'
        DOCTOR_FAILED=1
    fi

    if command -v pactl >/dev/null 2>&1 && pactl info >/dev/null 2>&1; then
        printf 'ok   Pulse/PipeWire pactl access works\n'
    else
        printf 'miss pactl cannot reach Pulse/PipeWire\n'
        DOCTOR_FAILED=1
    fi

    if command -v ffmpeg >/dev/null 2>&1; then
        if find_vaapi_device; then
            printf 'ok   VAAPI H.264 encoder: %s\n' "$VAAPI_DEVICE"
        else
            printf 'miss no working VAAPI H.264 render node found\n'
            DOCTOR_FAILED=1
        fi
    fi

    if [[ -n "$STREAM_KEY_COMMAND" ]]; then
        printf 'ok   stream key comes from YTWS_STREAM_KEY_COMMAND\n'
    elif [[ -n "$STREAM_KEY_FILE" ]]; then
        if [[ ! -r "$STREAM_KEY_FILE" ]]; then
            printf 'miss YTWS_STREAM_KEY_FILE is not readable: %s\n' "$STREAM_KEY_FILE"
            DOCTOR_FAILED=1
        elif (( (8#$(stat -c %a "$STREAM_KEY_FILE") & 8#077) != 0 )); then
            printf 'miss %s is readable by others; run: chmod 600 %s\n' "$STREAM_KEY_FILE" "$STREAM_KEY_FILE"
            DOCTOR_FAILED=1
        else
            printf 'ok   stream key file: %s\n' "$STREAM_KEY_FILE"
        fi
    else
        printf 'ok   stream key is asked for on the terminal when going live\n'
    fi

    local module
    if module="$(module_path)"; then
        printf 'ok   Hyprland module file: %s\n' "$module"
    else
        printf 'warn yt-stream-workspace.lua not found next to hyprland.lua\n'
    fi

    if (( DOCTOR_FAILED )); then
        printf '\nDoctor found blocking issues.\n'
        return 1
    fi
    printf '\nDoctor passed. Next useful check: workspace-stream self-test\n'
}

# --- self-test --------------------------------------------------------------

self_test_window() {
    local marker="$1" key
    clear
    printf 'yt-stream-workspace automated input target\n\n'
    printf 'Waiting for direct input on the mirrored stream output...\n'
    IFS= read -r -n 1 key
    printf '%s' "$key" >"$marker"
    while :; do
        printf '\rInput received: %q    %s' "$key" "$(date --iso-8601=seconds)"
        sleep 0.2
    done
}

focused_monitor() {
    hypr_call 'return hl.get_active_monitor().name'
}

# Where every window is: address, workspace, fullscreen, hidden.
window_placement() {
    hyprctl -j clients | jq -r '.[] | "\(.address) \(.workspace.name) \(.fullscreen) \(.hidden) \(.class)"' | sort
}

run_self_test() {
    validate_config
    require_commands hyprctl jq kitty wtype ffmpeg ffprobe setsid
    [[ ! -e "$STATE_FILE" ]] || die "stop the existing stream session before self-test"
    ensure_module

    local test_workspace="${YTWS_SELF_TEST_WORKSPACE:-99}"
    local marker="$RUN_DIR.self-test-$$"
    local test_pid=""
    local original_workspace before
    original_workspace="$(hypr_call 'return hl.get_active_workspace().id')"
    # The test must leave your own windows exactly where they were.
    before="$(window_placement)"

    cleanup_self_test() {
        if [[ -r "$STATE_FILE" ]]; then
            "$SELF" stop >/dev/null 2>&1 || true
        fi
        stop_pid "${test_pid:-}" kitty
        [[ -n "${marker:-}" ]] && rm -f "$marker"
        if [[ -n "${original_workspace:-}" ]]; then
            hyprctl dispatch "hl.dsp.focus({ workspace = \"$original_workspace\" })" >/dev/null 2>&1 || true
        fi
    }
    trap cleanup_self_test EXIT

    test_window_mapped() {
        hyprctl -j clients | jq -e --argjson pid "$test_pid" 'any(.[]; .pid == $pid and .mapped)' >/dev/null
    }
    test_pid="$(
        spawn_detached /dev/null kitty --class yt-stream-workspace-test \
            --title YT-Stream-Workspace-Test "$SELF" _self-test-window "$marker"
    )"
    wait_until "test window" test_window_mapped
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$test_workspace\", window = \"pid:$test_pid\", follow = false })" >/dev/null

    "$SELF" start "$test_workspace"
    # The state file is private shell data written by this command.
    # shellcheck disable=SC1090
    source "$STATE_FILE"
    local status
    status="$(hypr_call 'return YTWS.status()')"
    [[ "$(json_field "$status" showing)" == "$test_workspace" ]] ||
        die "the selected workspace is not active on the stream output"
    jq -e --arg ws "$test_workspace" '(.workspaces_on_output - [$ws, "stream-curtain"]) == []' \
        <<<"$status" >/dev/null || die "a private workspace is assigned to the stream output"
    note "stream activation and private-workspace placement passed"

    "$SELF" enter
    sleep 0.3
    wtype -s 200 v
    wait_until "keyboard input on the stream output" test -s "$marker"
    [[ "$(cat "$marker")" == "v" ]] || die "the stream workspace received the wrong key"
    note "mirrored display and direct keyboard control passed"

    "$SELF" leave
    sleep 0.2
    [[ "$(focused_monitor)" == "$PREVIEW_ON" ]] || die "leave did not restore physical input"
    note "input return to $PREVIEW_ON passed"

    "$SELF" test 5
    cleanup_self_test
    trap - EXIT
    local after moved
    after="$(window_placement)"
    moved="$(comm -23 <(printf '%s\n' "$before") <(printf '%s\n' "$after"))"
    if [[ -n "$moved" ]]; then
        printf 'workspace-stream: before the test:  %s\n' "$moved" >&2
        die "the self-test moved or changed windows it did not create"
    fi
    note "your own windows were left where they were"
    note "all automated integration checks passed"
}

case "${1:-}" in
start)
    start_session "${2:-}"
    ;;
stop)
    stop_session
    ;;
enter)
    module_action 'YTWS.enter()'
    ;;
leave)
    module_action 'YTWS.leave()'
    ;;
toggle)
    module_action 'YTWS.toggle()'
    ;;
curtain)
    set_curtain "${2:-}"
    ;;
workspace)
    switch_workspace "${2:-}"
    ;;
test)
    run_local_rtmp_test "${2:-5}"
    ;;
live)
    start_live
    ;;
stop-live)
    stop_live
    ;;
status)
    show_status "${2:-}"
    ;;
logs)
    show_logs
    ;;
doctor)
    run_doctor
    ;;
self-test)
    run_self_test
    ;;
_supervise)
    supervise_session
    ;;
_self-test-window)
    self_test_window "${2:?missing marker path}"
    ;;
-h|--help|help|"")
    usage
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
