     std::optional<uint64_t> first_frame_ts;
+    std::optional<frame_clock> clock;
+    bool clock_waits_for_audio = false;
+    uint64_t captured_before_clock = 0;
+
+    /* Encode the last frame again for slot (and the ones it skipped). */
+    auto repeat_until = [&] (int64_t slot) {
+        if (slot - clock->last_slot - 1 > CFR_MAX_FILL)
+            clock->last_slot = slot - 1;
+        while (clock->last_slot < slot) {
+            ++clock->last_slot;
+            ++clock->repeated;
+            if (!frame_writer->encode_last_frame(clock->slot_time(clock->last_slot) - first_frame_ts.value()))
+                return false;
+        }
+        return true;
+    };
+
+    /* --cfr: start the clock with the audio, showing the newest frame. A
+     * still screen sends no further frames, so the first slot cannot wait
+     * for one. */
+    auto start_clock = [&] (uint64_t frame_time) {
+        uint64_t origin = frame_time;
+#ifdef HAVE_AUDIO
+        if (pr) {
+            if (!pr->get_time_base()) {
+                clock_waits_for_audio = true;
+                return true;
+            }
+            origin = pr->get_time_base();
+        }
+#endif
+        clock_waits_for_audio = false;
+        first_frame_ts = origin;
+        clock = frame_clock{params.framerate, origin};
+        clock->captured = captured_before_clock;
+        clock->last_slot = 0;
+        return frame_writer->encode_last_frame(0);
+    };
