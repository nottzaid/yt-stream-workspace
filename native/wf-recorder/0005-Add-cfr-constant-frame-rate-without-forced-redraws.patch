+/* --cfr: frames are placed on a grid of slots at the frame rate, anchored
+ * on the first frame. A frame goes to the slot nearest to when it was
+ * rendered; a slot whose window passes without one repeats the last
+ * frame. Short gaps (a busy encoder) are filled, long ones (a stall)
+ * are not, so the output never runs ahead of real time. */
+#define CFR_MAX_FILL 2
+
+static uint64_t monotonic_usec()
+{
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return timespec_to_usec(ts);
+}
+
+struct frame_clock
+{
+    int fps;
+    uint64_t origin;
+    int64_t last_slot = -1;
+    uint64_t captured = 0;
+    uint64_t repeated = 0;
+
+    uint64_t slot_time(int64_t slot) const
+    {
+        return origin + slot * 1000000 / fps;
+    }
+
+    /* The slot whose window contains t. */
+    int64_t slot_at(uint64_t t) const
+    {
+        if (t < origin)
+            return 0;
+        return ((t - origin) * fps + 500000) / 1000000;
+    }
+
+    /* The last slot whose window has closed by t. */
+    int64_t closed_by(uint64_t t) const
+    {
+        return ((int64_t)(t - origin) * fps - 500000) / 1000000;
+    }
+
+    std::chrono::steady_clock::time_point next_deadline() const
+    {
+        uint64_t end = slot_time(last_slot + 1) + 500000 / fps;
+        return std::chrono::steady_clock::time_point(std::chrono::microseconds(end));
+    }
+};
