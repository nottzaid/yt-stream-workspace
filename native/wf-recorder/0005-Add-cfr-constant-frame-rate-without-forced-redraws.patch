+bool FrameWriter::encode_last_frame(int64_t usec)
+{
+    if (!last_frame)
+        return true;
+
+    AVFrame *frame = av_frame_clone(last_frame);
+    AVPacket *pkt = av_packet_alloc();
+    if (!frame || !pkt) {
+        av_frame_free(&frame);
+        av_packet_free(&pkt);
+        return false;
+    }
+
+    frame->pts = usec;
+    encode(videoCodecCtx, frame, pkt);
+    av_frame_free(&frame);
+    av_packet_free(&pkt);
+    return true;
+}
