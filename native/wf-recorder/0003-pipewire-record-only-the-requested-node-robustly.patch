 bool PipeWireReader::init()
 {
-    buf = new uint8_t[params.audio_frame_size * 4];
+    pending.resize(params.audio_frame_size);
 
     int argc = 0;
     pw_init(&argc, nullptr);
@@ -85,33 +140,85 @@ bool PipeWireReader::init()
     }
     pw_core_add_listener(core, &core_listener, &core_events, this);
 
+    if (params.audio_source) {
+        struct pw_registry *registry = pw_core_get_registry(core, PW_VERSION_REGISTRY, 0);
+        struct spa_hook registry_listener;
+        spa_zero(registry_listener);
+        pw_registry_add_listener(registry, &registry_listener, &registry_events, this);
+        seq = pw_core_sync(core, PW_ID_CORE, seq);
+        while (!synced && !core_failed)
+            pw_thread_loop_wait(thread_loop);
+        spa_hook_remove(&registry_listener);
+        pw_proxy_destroy(reinterpret_cast<struct pw_proxy*>(registry));
+
+        /* Recording some other device instead would put sound nobody
+         * chose into the recording. */
+        if (target_serial.empty() || core_failed) {
+            std::cerr << "pipewire: no audio node named " << params.audio_source << std::endl;
+            pw_thread_loop_unlock(thread_loop);
+            return false;
+        }
+        std::cerr << "Using PipeWire node: " << params.audio_source << std::endl;
+    }
+
+    pw_thread_loop_unlock(thread_loop);
     return true;
 }
 
+static void on_stream_state_changed(void *data, enum pw_stream_state, enum pw_stream_state state, const char *error)
+{
+    PipeWireReader *pr = static_cast<PipeWireReader*>(data);
+
+    if (state == PW_STREAM_STATE_ERROR) {
+        std::cerr << "pipewire: stream error: " << (error ? error : "unknown") << std::endl;
+        fail("audio capture failed");
+    } else if (state == PW_STREAM_STATE_STREAMING) {
+        pr->streaming = true;
+    }
+}
