 static void on_stream_process(void *data)
 {
     PipeWireReader *pr = static_cast<PipeWireReader*>(data);
 
     struct pw_buffer *b = pw_stream_dequeue_buffer(pr->stream);
-    if (!b) {
-        std::cerr << "pipewire: out of buffers: " << strerror(errno) << std::endl;
+    if (!b)
         return;
-    }
+
+    const size_t frame_size = pr->params.audio_frame_size;
+    const size_t sample_bytes = 2 * sizeof(float);
+    pr->last_process_nsec = pw_stream_get_nsec(pr->stream);
 
     for (uint32_t i = 0; i < b->buffer->n_datas; ++i) {
         struct spa_data *d = &b->buffer->datas[i];
-        memcpy(pr->buf + pr->buf_size, d->data, d->chunk->size);
-        pr->buf_size += d->chunk->size;
-        while (pr->buf_size >= pr->params.audio_frame_size) {
-            frame_writer->add_audio(pr->buf);
-            pr->buf_size -= pr->params.audio_frame_size;
-            if (pr->buf_size)
-                memmove(pr->buf, pr->buf + pr->params.audio_frame_size, pr->buf_size);
+        if (!d->data || !d->chunk)
+            continue;
+
+        const uint32_t offset = std::min(d->chunk->offset, d->maxsize);
+        size_t left = std::min(d->chunk->size, d->maxsize - offset);
+        left -= left % sample_bytes;
+        const uint8_t *src = static_cast<const uint8_t*>(d->data) + offset;
+
+        if (left && !pr->time_base) {
+            /* The buffer holds the quantum that ended when its cycle
+             * started; date the first sample, not the cycle. */
+            uint64_t nsec = b->time ? b->time : pr->last_process_nsec;
+            uint64_t span = left / sample_bytes * SPA_NSEC_PER_SEC / pr->params.sample_rate;
+            pr->time_base = (nsec > span ? nsec - span : nsec) / 1000;
         }
-    }
 
-    if (!pr->time_base)
-        pr->time_base = b->time;
+        while (left) {
+            size_t n = std::min(left, frame_size - pr->pending_size);
+            memcpy(pr->pending.data() + pr->pending_size, src, n);
+            pr->pending_size += n;
+            src += n;
+            left -= n;
+            if (pr->pending_size == frame_size) {
+                frame_writer->add_audio(pr->pending.data());
+                pr->pending_size = 0;
+            }
+        }
+    }
 
     pw_stream_queue_buffer(pr->stream, b);
 }
