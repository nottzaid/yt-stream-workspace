+static void on_registry_global(void *data, uint32_t, uint32_t, const char *type, uint32_t, const struct spa_dict *props)
+{
+    PipeWireReader *pr = static_cast<PipeWireReader*>(data);
+
+    if (strcmp(type, PW_TYPE_INTERFACE_Node) != 0 || pr->target_exact)
+        return;
+
+    const char *name = spa_dict_lookup(props, PW_KEY_NODE_NAME);
+    const char *media_class = spa_dict_lookup(props, PW_KEY_MEDIA_CLASS);
+    const char *serial = spa_dict_lookup(props, PW_KEY_OBJECT_SERIAL);
+    if (!name || !media_class || !serial || strncmp(media_class, "Audio/", 6) != 0)
+        return;
+
+    const bool is_sink = strstr(media_class, "Sink") != nullptr;
+    const std::string wanted = pr->params.audio_source;
+    const std::string monitor_suffix = ".monitor";
+
+    if (wanted == name) {
+        pr->target_exact = true;
+    } else if (is_sink && wanted.size() > monitor_suffix.size() &&
+        wanted.compare(wanted.size() - monitor_suffix.size(), std::string::npos, monitor_suffix) == 0 &&
+        wanted.compare(0, wanted.size() - monitor_suffix.size(), name) == 0) {
+        /* PulseAudio spelling of a sink's monitor: capture the sink. */
+    } else {
+        return;
+    }
+
+    pr->target_serial = serial;
+    pr->target_is_sink = is_sink;
+}
+
+static const struct pw_registry_events registry_events = {
+    .version = PW_VERSION_REGISTRY_EVENTS,
+    .global = on_registry_global,
+    .global_remove = nullptr,
+};
