+/* Readable once exit is requested, so a wait on the compositor wakes up
+ * even when no frame is coming. */
+static int exit_fd = -1;
+
+buffer_pool<wf_buffer, 16> buffers;
+
+static void signal_exit()
+{
+    exit_main_loop = true;
+    if (exit_fd >= 0) {
+        uint64_t one = 1;
+        ssize_t written = write(exit_fd, &one, sizeof(one));
+        (void)written;
+    }
+}
