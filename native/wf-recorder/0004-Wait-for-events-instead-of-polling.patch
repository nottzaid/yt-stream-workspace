+    // Block until the current capture buffer can take a new frame, or stop.
+    void wait_capture(const std::atomic<bool>& stop)
+    {
+        std::unique_lock<std::mutex> lock(mutex);
+        changed.wait(lock, [&] { return stop || bufs[capture_idx]->ready_capture(); });
+    }
+
+    // Block until the current encode buffer holds a frame, or stop.
+    void wait_encode(const std::atomic<bool>& stop)
+    {
+        std::unique_lock<std::mutex> lock(mutex);
+        changed.wait(lock, [&] { return stop || bufs[encode_idx]->ready_encode(); });
+    }
+
+    // Wake the waiters so they notice a stop request.
+    void wake()
+    {
+        { std::lock_guard<std::mutex> lock(mutex); }
+        changed.notify_all();
+    }
