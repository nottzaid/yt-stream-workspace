+/* wl_display_dispatch(), but also returning once exit is requested. */
+static int dispatch_wayland()
+{
+    if (wl_display_prepare_read(display) == -1)
+        return wl_display_dispatch_pending(display);
+
+    struct pollfd fds[2] = {
+        { wl_display_get_fd(display), POLLIN, 0 },
+        { exit_fd, POLLIN, 0 },
+    };
+
+    while (wl_display_flush(display) == -1) {
+        if (errno != EAGAIN) {
+            wl_display_cancel_read(display);
+            return errno == EPIPE ? 0 : -1;
+        }
+        fds[0].events = POLLOUT;
+        if ((poll(fds, 2, -1) == -1 && errno != EINTR) || exit_main_loop) {
+            wl_display_cancel_read(display);
+            return -1;
+        }
+    }
+
+    fds[0].events = POLLIN;
+    while (poll(fds, 2, -1) == -1) {
+        if (errno != EINTR || exit_main_loop) {
+            wl_display_cancel_read(display);
+            return -1;
+        }
+    }
+    if (exit_main_loop || !(fds[0].revents & (POLLIN | POLLERR | POLLHUP))) {
+        wl_display_cancel_read(display);
+        return -1;
+    }
+
+    if (wl_display_read_events(display) == -1)
+        return -1;
+    return wl_display_dispatch_pending(display);
+}
