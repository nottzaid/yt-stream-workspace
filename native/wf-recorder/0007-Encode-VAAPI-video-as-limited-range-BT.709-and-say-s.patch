From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kant <283011337+muradkant@users.noreply.github.com>
Date: Sat, 3 Oct 2026 23:49:59 +0300
Subject: [PATCH 7/7] Encode VAAPI video as limited-range BT.709, and say so

The default VAAPI filter asked for full-range output, and since the
encoder no longer sets the colour range the stream carried no colour
description at all, leaving players and YouTube to guess both range and
matrix. Convert to limited range with the BT.709 matrix, which is what
SDR video is assumed to be, and describe exactly that in the stream:
range, matrix, primaries and transfer. Codec options given with -p still
take precedence.
---
 src/frame-writer.cpp | 6 ++++++
 src/frame-writer.hpp | 3 +++
 src/main.cpp         | 5 ++++-
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/frame-writer.cpp b/src/frame-writer.cpp
index acffed1..92e6d3b 100644
--- a/src/frame-writer.cpp
+++ b/src/frame-writer.cpp
@@ -509,6 +509,12 @@ void FrameWriter::init_video_stream()
     videoCodecCtx->width      = params.width;
     videoCodecCtx->height     = params.height;
     videoCodecCtx->time_base  = US_RATIONAL;
+    if (params.bt709_limited) {
+        videoCodecCtx->color_range = AVCOL_RANGE_MPEG;
+        videoCodecCtx->colorspace = AVCOL_SPC_BT709;
+        videoCodecCtx->color_primaries = AVCOL_PRI_BT709;
+        videoCodecCtx->color_trc = AVCOL_TRC_BT709;
+    }
     if (params.framerate) {
         std::cerr << "Framerate: " << params.framerate << std::endl;
     }
diff --git a/src/frame-writer.hpp b/src/frame-writer.hpp
index 2410322..9c23f54 100644
--- a/src/frame-writer.hpp
+++ b/src/frame-writer.hpp
@@ -69,6 +69,9 @@ struct FrameWriterParams
     /* Encode on a real-time clock at framerate, repeating the last frame
      * when the compositor sends none (see encode_last_frame()). */
     bool cfr = false;
+    /* The video is converted to limited-range BT.709; say so in the
+     * stream. */
+    bool bt709_limited = false;
     int sample_rate;
     int buffrate = 0;
     int32_t transform = 0;
diff --git a/src/main.cpp b/src/main.cpp
index ce8adfa..82e3dc2 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1765,7 +1765,10 @@ int main(int argc, char *argv[])
 
         if (params.video_filter == "null")
         {
-            params.video_filter = "scale_vaapi=format=nv12:out_range=full";
+            /* The range and matrix every player assumes for SDR video
+             * unless told otherwise, and the stream tells them. */
+            params.video_filter = "scale_vaapi=format=nv12:out_range=tv:out_color_matrix=bt709";
+            params.bt709_limited = true;
             if (!use_dmabuf)
             {
                 params.video_filter.insert(0, "hwupload,");
