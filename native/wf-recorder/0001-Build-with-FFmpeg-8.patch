From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kant <283011337+muradkant@users.noreply.github.com>
Date: Sat, 3 Oct 2026 19:52:57 +0300
Subject: [PATCH 1/7] Build with FFmpeg 8

FFmpeg 8 removed AVCodec.pix_fmts, sample_fmts and ch_layouts. Query
them with avcodec_get_supported_config() where it exists (FFmpeg 7.1
and later) and keep reading the fields on older versions.
---
 src/frame-writer.cpp | 68 +++++++++++++++++++++++++++++++++-----------
 1 file changed, 52 insertions(+), 16 deletions(-)

diff --git a/src/frame-writer.cpp b/src/frame-writer.cpp
index 34d16d6..1275a5f 100644
--- a/src/frame-writer.cpp
+++ b/src/frame-writer.cpp
@@ -93,6 +93,39 @@ void FrameWriter::load_audio_codec_options(AVDictionary **dict)
     }
 }
 
+/* FFmpeg 8 removed the supported-format lists from AVCodec; ask for them
+ * the way FFmpeg 7.1 introduced. */
+#define HAVE_SUPPORTED_CONFIG (LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100))
+
+static const void *codec_supported(const AVCodec *codec, int config, const void *legacy)
+{
+#if HAVE_SUPPORTED_CONFIG
+    (void)legacy;
+    const void *configs = NULL;
+    int count = 0;
+    if (avcodec_get_supported_config(NULL, codec, (enum AVCodecConfig)config, 0, &configs, &count) < 0)
+        return NULL;
+    return configs;
+#else
+    (void)codec;
+    (void)config;
+    return legacy;
+#endif
+}
+
+#if HAVE_SUPPORTED_CONFIG
+#define CODEC_PIX_FMTS(codec) \
+    ((const AVPixelFormat*)codec_supported(codec, AV_CODEC_CONFIG_PIX_FORMAT, NULL))
+#define CODEC_SAMPLE_FMTS(codec) \
+    ((const AVSampleFormat*)codec_supported(codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, NULL))
+#define CODEC_CH_LAYOUTS(codec) \
+    ((const AVChannelLayout*)codec_supported(codec, AV_CODEC_CONFIG_CHANNEL_LAYOUT, NULL))
+#else
+#define CODEC_PIX_FMTS(codec) ((codec)->pix_fmts)
+#define CODEC_SAMPLE_FMTS(codec) ((codec)->sample_fmts)
+#define CODEC_CH_LAYOUTS(codec) ((codec)->ch_layouts)
+#endif
+
 bool is_fmt_supported(AVPixelFormat fmt, const AVPixelFormat *supported)
 {
     for (int i = 0; supported[i] != AV_PIX_FMT_NONE; i++)
@@ -192,21 +225,22 @@ AVPixelFormat FrameWriter::handle_buffersink_pix_fmt(const AVCodec *codec)
     auto in_fmt = get_input_format();
 
     /* For codecs such as rawvideo no supported formats are listed */
-    if (!codec->pix_fmts)
+    const AVPixelFormat *pix_fmts = CODEC_PIX_FMTS(codec);
+    if (!pix_fmts)
         return in_fmt;
 
     /* If the codec supports getting the appropriate RGB format
      * directly, we want to use it since we don't have to convert data */
-    if (is_fmt_supported(in_fmt, codec->pix_fmts))
+    if (is_fmt_supported(in_fmt, pix_fmts))
         return in_fmt;
 
     /* Choose the format supported by the codec which best approximates the
      * input fmt. */
     AVPixelFormat best_format = AV_PIX_FMT_NONE;
-    for (int i = 0; codec->pix_fmts[i] != AV_PIX_FMT_NONE; i++) {
+    for (int i = 0; pix_fmts[i] != AV_PIX_FMT_NONE; i++) {
         int loss = 0;
         best_format = av_find_best_pix_fmt_of_2(best_format,
-            codec->pix_fmts[i], in_fmt, false, &loss);
+            pix_fmts[i], in_fmt, false, &loss);
     }
     return best_format;
 }
@@ -517,16 +551,17 @@ void FrameWriter::init_video_stream()
 static uint64_t get_codec_channel_layout(const AVCodec *codec)
 {
     int i = 0;
-    if (!codec->ch_layouts)
+    const AVChannelLayout *ch_layouts = CODEC_CH_LAYOUTS(codec);
+    if (!ch_layouts)
         return AV_CH_LAYOUT_STEREO;
     while (1) {
-        if (!av_channel_layout_check(&codec->ch_layouts[i]))
+        if (!av_channel_layout_check(&ch_layouts[i]))
             break;
-        if (codec->ch_layouts[i].u.mask == AV_CH_LAYOUT_STEREO)
-            return codec->ch_layouts[i].u.mask;
+        if (ch_layouts[i].u.mask == AV_CH_LAYOUT_STEREO)
+            return ch_layouts[i].u.mask;
         i++;
     }
-    return codec->ch_layouts[0].u.mask;
+    return ch_layouts[0].u.mask;
 }
 #else
 static uint64_t get_codec_channel_layout(const AVCodec *codec)
@@ -548,20 +583,21 @@ static uint64_t get_codec_channel_layout(const AVCodec *codec)
 static enum AVSampleFormat get_codec_auto_sample_fmt(const AVCodec *codec)
 {
     int i = 0;
-    if (!codec->sample_fmts)
+    const AVSampleFormat *sample_fmts = CODEC_SAMPLE_FMTS(codec);
+    if (!sample_fmts)
         return av_get_sample_fmt(FALLBACK_AUDIO_SAMPLE_FMT);
     while (1) {
-        if (codec->sample_fmts[i] == -1)
+        if (sample_fmts[i] == -1)
             break;
-        if (av_get_bytes_per_sample(codec->sample_fmts[i]) >= 2)
-            return codec->sample_fmts[i];
+        if (av_get_bytes_per_sample(sample_fmts[i]) >= 2)
+            return sample_fmts[i];
         i++;
     }
-    return codec->sample_fmts[0];
+    return sample_fmts[0];
 }
 
 bool check_fmt_available(const AVCodec *codec, AVSampleFormat fmt){
-    for (const enum AVSampleFormat *sample_ptr = codec -> sample_fmts; *sample_ptr != -1; sample_ptr++)
+    for (const enum AVSampleFormat *sample_ptr = CODEC_SAMPLE_FMTS(codec); *sample_ptr != -1; sample_ptr++)
     {
         if (*sample_ptr == fmt)
         {
@@ -578,7 +614,7 @@ static enum AVSampleFormat convert_codec_sample_fmt(const AVCodec *codec, std::s
     {
         std::cerr << "Failed to find the given sample format: " << requested_fmt << std::endl;
         std::exit(-1);
-    } else if (!codec->sample_fmts || check_fmt_available(codec, converted_fmt))
+    } else if (!CODEC_SAMPLE_FMTS(codec) || check_fmt_available(codec, converted_fmt))
     {
         std::cerr << "Using sample format " << av_get_sample_fmt_name(converted_fmt) << " for audio codec " << codec->name << std::endl;
         return converted_fmt;
