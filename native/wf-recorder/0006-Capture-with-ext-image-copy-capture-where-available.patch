 zwlr_screencopy_frame_v1 *frame = NULL;
 
+#ifdef HAVE_EXT_IMAGE_COPY_CAPTURE
+/* ext-image-copy-capture, used for damage-driven DMA-BUF capture of a whole
+ * output where the compositor offers it. Unlike wlr-screencopy it gives the
+ * buffer constraints once per session, and some compositors (Hyprland) only
+ * complete its frames when the output changes, where a pending
+ * wlr-screencopy frame makes them redraw the output at full rate. */
+static bool use_ext_capture = false;
+static ext_image_copy_capture_session_v1 *ext_session = NULL;
+static ext_image_copy_capture_frame_v1 *ext_frame = NULL;
+
+struct ext_capture_constraints
+{
+    uint32_t width = 0, height = 0;
+    uint32_t format = 0;
+    bool linear = false;
+};
+static ext_capture_constraints ext_pending, ext_current;
+static bool ext_collecting = false; // between the first constraint and done
+static bool ext_have_constraints = false;
+static bool ext_stopped = false;
+static bool ext_waiting_for_constraints = false;
+static bool ext_got_time = false;
+
+static void ext_begin_constraints()
+{
+    if (!ext_collecting) {
+        ext_pending = {};
+        ext_collecting = true;
+    }
+}
+
+static void ext_session_buffer_size(void*, ext_image_copy_capture_session_v1*, uint32_t width, uint32_t height)
+{
+    ext_begin_constraints();
+    ext_pending.width = width;
+    ext_pending.height = height;
+}
+
+static void ext_session_shm_format(void*, ext_image_copy_capture_session_v1*, uint32_t)
+{
+    ext_begin_constraints();
+}
+
+static void ext_session_dmabuf_device(void*, ext_image_copy_capture_session_v1*, wl_array*)
+{
+    ext_begin_constraints();
+}
+
+static void ext_session_dmabuf_format(void*, ext_image_copy_capture_session_v1*, uint32_t format, wl_array *modifiers)
+{
+    ext_begin_constraints();
+    /* Like wlr-screencopy: the first format offered, in linear layout,
+     * which every encoder path here can import. */
+    if (ext_pending.format)
+        return;
+    const uint64_t *mods = (const uint64_t*) modifiers->data;
+    for (size_t i = 0; i < modifiers->size / sizeof(uint64_t); ++i) {
+        if (mods[i] == DRM_FORMAT_MOD_LINEAR) {
+            ext_pending.format = format;
+            ext_pending.linear = true;
+        }
+    }
+}
+
+static void ext_session_done(void*, ext_image_copy_capture_session_v1*)
+{
+    ext_current = ext_pending;
+    ext_collecting = false;
+    ext_have_constraints = ext_current.width && ext_current.height && ext_current.linear;
+    if (ext_waiting_for_constraints && ext_have_constraints) {
+        ext_waiting_for_constraints = false;
+        request_next_frame();
+    }
+}
+
+static void ext_session_stopped(void*, ext_image_copy_capture_session_v1*)
+{
+    ext_stopped = true;
+    if (use_ext_capture) {
+        std::cerr << "The captured output is gone, stopping" << std::endl;
+        request_exit(true);
+    }
+}
+
+static const ext_image_copy_capture_session_v1_listener ext_session_listener = {
+    .buffer_size = ext_session_buffer_size,
+    .shm_format = ext_session_shm_format,
+    .dmabuf_device = ext_session_dmabuf_device,
+    .dmabuf_format = ext_session_dmabuf_format,
+    .done = ext_session_done,
+    .stopped = ext_session_stopped,
+};
+
+static void ext_frame_transform(void*, ext_image_copy_capture_frame_v1*, uint32_t)
+{
+}
+
+static void ext_frame_damage(void*, ext_image_copy_capture_frame_v1*, int32_t, int32_t, int32_t, int32_t)
+{
+}
+
+static void ext_frame_presentation_time(void*, ext_image_copy_capture_frame_v1*, uint32_t tv_sec_hi,
+    uint32_t tv_sec_lo, uint32_t tv_nsec)
+{
+    auto& buffer = buffers.capture();
+    buffer.presented.tv_sec = ((1ll * tv_sec_hi) << 32ll) | tv_sec_lo;
+    buffer.presented.tv_nsec = tv_nsec;
+    ext_got_time = true;
+}
+
+static void ext_frame_ready(void*, ext_image_copy_capture_frame_v1*)
+{
+    if (!ext_got_time)
+        clock_gettime(CLOCK_MONOTONIC, &buffers.capture().presented);
+    buffer_copy_done = true;
+    frame_failed_cnt = 0;
+}
+
+static void ext_frame_failed(void*, ext_image_copy_capture_frame_v1*, uint32_t reason)
+{
+    if (reason == EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED || ext_stopped) {
+        std::cerr << "The captured output is gone, stopping" << std::endl;
+        request_exit(true);
+        return;
+    }
+    if (++frame_failed_cnt > MAX_FRAME_FAILURES) {
+        std::cerr << "Failed to copy frame too many times, exiting!" << std::endl;
+        request_exit(true);
+        return;
+    }
+    if (reason == EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS && ext_collecting) {
+        /* New constraints are on their way; retry once they are complete. */
+        ext_waiting_for_constraints = true;
+        return;
+    }
+    request_next_frame();
+}
+
+static const ext_image_copy_capture_frame_v1_listener ext_frame_listener = {
+    .transform = ext_frame_transform,
+    .damage = ext_frame_damage,
+    .presentation_time = ext_frame_presentation_time,
+    .ready = ext_frame_ready,
+    .failed = ext_frame_failed,
+};
+
+/* A linear DMA-BUF in the session's current size and format. */
+static bool ext_prepare_buffer(wf_buffer& buffer)
+{
+    const auto& c = ext_current;
+    if (buffer.bo && buffer.wl_buffer && buffer.width == (int)c.width &&
+        buffer.height == (int)c.height && buffer.drm_format == (int)c.format)
+        return true;
+
+    if (buffer.wl_buffer)
+        wl_buffer_destroy(buffer.wl_buffer);
+    buffer.wl_buffer = NULL;
+    if (buffer.params)
+        zwp_linux_buffer_params_v1_destroy(buffer.params);
+    buffer.params = NULL;
+    if (buffer.bo)
+        gbm_bo_destroy(buffer.bo);
+
+    const uint64_t modifier = DRM_FORMAT_MOD_LINEAR;
+    buffer.bo = gbm_bo_create_with_modifiers(gbm_device, c.width, c.height, c.format, &modifier, 1);
+    if (!buffer.bo)
+        buffer.bo = gbm_bo_create(gbm_device, c.width, c.height, c.format, GBM_BO_USE_LINEAR | GBM_BO_USE_RENDERING);
+    if (!buffer.bo) {
+        std::cerr << "Failed to create gbm bo" << std::endl;
+        return false;
+    }
+
+    buffer.format = drm_to_wl_shm_format(c.format);
+    buffer.drm_format = c.format;
+    buffer.width = c.width;
+    buffer.height = c.height;
+    buffer.stride = gbm_bo_get_stride(buffer.bo);
+    buffer.y_invert = false;
+
+    auto params = zwp_linux_dmabuf_v1_create_params(dmabuf);
+    uint64_t mod = gbm_bo_get_modifier(buffer.bo);
+    int fd = gbm_bo_get_fd(buffer.bo);
+    zwp_linux_buffer_params_v1_add(params, fd, 0, gbm_bo_get_offset(buffer.bo, 0),
+        gbm_bo_get_stride(buffer.bo), mod >> 32, mod & 0xffffffff);
+    close(fd); // the request carries its own copy
+    buffer.wl_buffer = zwp_linux_buffer_params_v1_create_immed(params, c.width, c.height, c.format, 0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    return true;
+}
+
+static void request_next_ext_frame()
+{
+    if (ext_frame)
+        ext_image_copy_capture_frame_v1_destroy(ext_frame);
+    ext_frame = NULL;
+
+    if (!ext_have_constraints) {
+        ext_waiting_for_constraints = true;
+        return;
+    }
+
+    auto& buffer = buffers.capture();
+    if (!ext_prepare_buffer(buffer)) {
+        request_exit(true);
+        return;
+    }
+
+    ext_got_time = false;
+    ext_frame = ext_image_copy_capture_session_v1_create_frame(ext_session);
+    ext_image_copy_capture_frame_v1_add_listener(ext_frame, &ext_frame_listener, NULL);
+    ext_image_copy_capture_frame_v1_attach_buffer(ext_frame, buffer.wl_buffer);
+    ext_image_copy_capture_frame_v1_damage_buffer(ext_frame, 0, 0, buffer.width, buffer.height);
+    ext_image_copy_capture_frame_v1_capture(ext_frame);
+}
+
+/* Open a session on the chosen output; false if this compositor cannot
+ * give it what the encoder needs, so wlr-screencopy is used instead. */
+static bool start_ext_capture()
+{
+    if (!ext_source_manager || !ext_capture_manager)
+        return false;
+
+    auto source = ext_output_image_capture_source_manager_v1_create_source(ext_source_manager, chosen_output->output);
+    ext_session = ext_image_copy_capture_manager_v1_create_session(ext_capture_manager, source,
+        EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS);
+    ext_image_capture_source_v1_destroy(source);
+    ext_image_copy_capture_session_v1_add_listener(ext_session, &ext_session_listener, NULL);
+    for (int i = 0; i < 5 && !ext_have_constraints && !ext_stopped; ++i)
+        wl_display_roundtrip(display);
+
+    if (!ext_have_constraints) {
+        ext_image_copy_capture_session_v1_destroy(ext_session);
+        ext_session = NULL;
+        return false;
+    }
+    return true;
+}
+#endif
+
 void request_next_frame()
 {
+#ifdef HAVE_EXT_IMAGE_COPY_CAPTURE
+    if (use_ext_capture) {
+        request_next_ext_frame();
+        return;
+    }
+#endif
+
     if (frame != NULL)
     {
         zwlr_screencopy_frame_v1_destroy(frame);
@@ -1576,6 +1843,7 @@ int main(int argc, char *argv[])
     }
 
     params.transform = chosen_output->transform;
+    const bool region_requested = selected_region.is_selected();
 
     if (selected_region.is_selected())
     {
@@ -1594,6 +1862,16 @@ int main(int argc, char *argv[])
 
     fprintf(stderr, "selected region %d,%d %dx%d\n", selected_region.x, selected_region.y, selected_region.width, selected_region.height);
 
+#ifdef HAVE_EXT_IMAGE_COPY_CAPTURE
+    if (use_damage && use_dmabuf && !region_requested) {
+        use_ext_capture = start_ext_capture();
+        std::cerr << (use_ext_capture ? "capturing with ext-image-copy-capture" :
+            "capturing with wlr-screencopy") << std::endl;
+    }
+#else
+    (void)region_requested;
+#endif
+
     bool spawned_thread = false;
     std::thread writer_thread;
 
