# yt-stream-workspace user configuration.
# Copy to ~/.config/yt-stream-workspace/config and edit if needed.

# Name of the Hyprland headless output used as the captured stream output.
YTWS_OUTPUT=YT-STREAM

# Virtual output mode. Defaults are chosen for YouTube 1080p60.
YTWS_WIDTH=1920
YTWS_HEIGHT=1080
YTWS_FPS=60
YTWS_SCALE=1.5

# wl-mirror tries GPU DMA-BUF paths first in auto mode. To require the fastest
# path instead of allowing a shared-memory fallback, set extcopy-dmabuf.
YTWS_MIRROR_BACKEND=auto

# Hardware encoder. Leave empty for auto-detection. On Intel laptops this is
# usually /dev/dri/renderD128. NVIDIA MX110/MX130-class GPUs do not provide
# NVENC, so they are not useful for H.264 offload here.
# YTWS_VAAPI_DEVICE=/dev/dri/renderD128

# wf-recorder / VAAPI bitrate settings.
YTWS_VIDEO_BITRATE=12M
YTWS_VIDEO_MAXRATE=12M
YTWS_VIDEO_BUFSIZE=24M
YTWS_VIDEO_GOP=120
YTWS_AUDIO_BITRATE=128k

# What viewers hear while you are live: "default" follows the default output
# device (everything your speakers play) and the default microphone, "none"
# leaves one out, a PipeWire node name pins a device. Nothing is captured,
# and the microphone stays closed, while nothing is recorded.
YTWS_DESKTOP_AUDIO=default
YTWS_MIC=default

# The recorder and the preview client. Empty uses the builds from
# native/build.sh when they are installed, else wf-recorder and wl-mirror from
# PATH. The YTWS_MIRROR_BACKEND setting above applies only to wl-mirror.
# YTWS_RECORDER=
# YTWS_PREVIEW=

# Local RTMP validation port used by `workspace-stream test`.
YTWS_TEST_RTMP_PORT=19350

# YouTube RTMPS ingest base URL.
YTWS_YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com/live2

# Where `workspace-stream live` gets the stream key. With neither set it asks
# on the terminal. A command prints the key on its first line; a key file must
# be readable only by you (chmod 600). Either one lets you go live from a key
# binding.
# YTWS_STREAM_KEY_COMMAND='secret-tool lookup service youtube-stream-key'
# YTWS_STREAM_KEY_FILE="$HOME/.config/yt-stream-workspace/stream-key"

# Desktop notifications when you go live, lose the connection, reconnect, or
# YouTube refuses the stream. 0 turns them off.
YTWS_NOTIFY=1

# Optional wallpaper on the virtual output, if swaybg is installed.
YTWS_WALLPAPER="$HOME/Pictures/background.jpg"

# Monitor that shows the preview. Empty means the monitor the stream workspace
# was on when the session started.
# YTWS_PREVIEW_MONITOR=eDP-1

# Layer surfaces on the stream output (bars, notifications, launchers, ...)
# are painted black in the capture unless their namespace fully matches this
# regular expression. `workspace-stream status` lists the namespaces present.
YTWS_STREAM_LAYERS='.*wallpaper.*|hyprpaper|swww-daemon|mpvpaper.*'

# Windows whose class fully matches this regular expression are always painted
# black in the capture. Set it to an empty string to disable.
YTWS_PRIVATE_WINDOWS='org\.keepassxc\.KeePassXC|KeePassXC|1[Pp]assword|[Bb]itwarden|com\.bitwarden\.desktop|gcr-prompter|org\.gnome\.seahorse\.Application'
